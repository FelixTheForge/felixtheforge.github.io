---
/**
 * Renders a post's cover image. If the post has no `cover` field, falls
 * back to a deterministic gradient + the post title in large type.
 *
 * Usage:
 *   <PostCover title={post.data.title} cover={post.data.cover}
 *              variant="thumb" | "card" | "hero" />
 */
interface Props {
  title: string;
  cover?: string;
  variant?: 'thumb' | 'card' | 'hero';
  className?: string;
  loading?: 'eager' | 'lazy';
}
const { title, cover, variant = 'card', className = '', loading = 'lazy' } = Astro.props;

// ── Deterministic gradient pick from title ──
// Same title → same gradient across rebuilds.
const GRADIENTS: [string, string, string][] = [
  ['#0071e3', '#5e5ce6', '#bf5af2'],   // blue → indigo → purple
  ['#bf5af2', '#ec4899', '#ff375f'],   // purple → pink → red
  ['#30d158', '#00c7be', '#0071e3'],   // green → cyan → blue
  ['#ff9f0a', '#ff375f', '#bf5af2'],   // orange → red → purple
  ['#5e5ce6', '#ec4899', '#ff9f0a'],   // indigo → pink → orange
  ['#00c7be', '#30d158', '#ffd60a'],   // teal → green → yellow
  ['#ec4899', '#ff9f0a', '#ffd60a'],   // pink → orange → yellow
  ['#0071e3', '#00c7be', '#30d158'],   // blue → teal → green
];

function hashCode(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = ((h << 5) - h + s.charCodeAt(i)) | 0;
  return Math.abs(h);
}
const idx = hashCode(title) % GRADIENTS.length;
const [c1, c2, c3] = GRADIENTS[idx];

// Short title for hero variant (truncate if too long)
const displayTitle = title.length > 60 ? title.slice(0, 60) + '…' : title;
---

{cover ? (
  <img src={cover} alt={title}
       class={`pc-img pc-${variant} ${className}`}
       loading={loading} decoding="async"/>
) : (
  <div class={`pc-fallback pc-${variant} ${className}`}
       style={`background:
         radial-gradient(circle at 20% 20%, ${c1} 0%, transparent 55%),
         radial-gradient(circle at 80% 30%, ${c3} 0%, transparent 50%),
         linear-gradient(135deg, ${c2} 0%, ${c1} 100%);`}
       aria-label={title}>
    <span class="pc-noise"></span>
    <span class="pc-title">{displayTitle}</span>
  </div>
)}

<style is:global>
  .pc-img, .pc-fallback {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .pc-fallback {
    position: relative;
    overflow: hidden;
    display: flex; align-items: flex-end;
    color: #fff;
  }
  /* Static noise texture overlay — adds subtle grain to the flat gradient */
  .pc-fallback .pc-noise {
    position: absolute; inset: 0;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    opacity: .08;
    mix-blend-mode: overlay;
  }
  .pc-fallback .pc-title {
    position: relative; z-index: 1;
    padding: 1rem 1.25rem;
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1.15;
    text-shadow: 0 2px 12px rgba(0,0,0,.25);
  }

  /* Variants — different size of the title overlay */
  .pc-fallback.pc-thumb .pc-title { font-size: .65rem; padding: .4rem .55rem; }
  .pc-fallback.pc-card  .pc-title { font-size: 1.1rem; padding: 1rem 1.25rem; }
  .pc-fallback.pc-hero  .pc-title { font-size: clamp(1.5rem,4vw,2.5rem); padding: 2rem 2.5rem; }
</style>

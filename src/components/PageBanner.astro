---
interface Props {
  title: string;
  subtitle?: string;
  image: string;
  tint?: string; // e.g. "rgba(20,30,20,.55)"
}
const { title, subtitle, image, tint = 'rgba(10,14,10,.52)' } = Astro.props;
---

<div class="banner">
  <div class="banner-bg" style={`background-image:url('${image}')`}></div>
  <div class="banner-overlay" style={`background:linear-gradient(to bottom,${tint} 0%,rgba(10,14,10,.3) 60%,var(--color-bg) 100%)`}></div>
  <div class="banner-content">
    <h1 class="banner-title">{title}</h1>
    {subtitle && <p class="banner-sub">{subtitle}</p>}
  </div>
</div>

<style>
  .banner {
    position: relative; height: 22rem; margin: 0 -1.5rem;
    display: flex; align-items: flex-end; overflow: hidden;
  }
  .banner-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    animation: drift 25s ease-in-out infinite alternate;
  }
  @keyframes drift {
    from { transform: scale(1.04) translateX(0); }
    to   { transform: scale(1.08) translateX(-1%); }
  }
  [data-theme="dark"] .banner-bg { filter: brightness(.7); }

  .banner-overlay { position: absolute; inset: 0; }

  .banner-content {
    position: relative; z-index: 1;
    padding: 0 2rem 2.5rem; max-width: 56rem; margin: 0 auto; width: 100%;
  }
  .banner-title {
    font-family: var(--font-serif); font-size: clamp(2rem,5vw,3rem);
    font-weight: 500; color: #fff; line-height: 1.15; margin-bottom: .4rem;
    text-shadow: 0 2px 20px rgba(0,0,0,.3);
  }
  .banner-sub {
    font-family: var(--font-serif); font-style: italic;
    color: rgba(255,255,255,.72); font-size: 1rem;
  }
</style>

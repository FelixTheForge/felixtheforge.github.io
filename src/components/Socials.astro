---
/**
 * Renders a row of social-link icons for whichever platforms have URLs
 * configured in SITE.social. Order in the rendered output = order of
 * keys in the config object.
 *
 * Add a new platform:
 *   1. Add the URL to SITE.social in src/config/site.ts
 *   2. Add a matching entry below in ICONS (label + inline SVG)
 */
import { SITE } from '../config/site';

interface Props {
  className?: string;   // applied to each anchor
}
const { className = '' } = Astro.props;

// Inline SVG icons (single-color, fill currentColor)
const ICONS: Record<string, { label: string; svg: string; rel?: string; hrefPrefix?: string }> = {
  github: {
    label: 'GitHub',
    svg: '<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>',
  },
  twitter: {
    label: 'X (Twitter)',
    svg: '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
  },
  facebook: {
    label: 'Facebook',
    svg: '<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>',
  },
  douyin: {
    label: '抖音 Douyin',
    svg: '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.71a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.14z"/></svg>',
  },
  email: {
    label: 'Email',
    svg: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3 7 12 13 21 7"/></svg>',
    hrefPrefix: 'mailto:',
  },
};

// Build list in config order, skipping empty URLs / platforms with no icon
const entries = Object.entries(SITE.social || {}).filter(
  ([key, url]) => url && ICONS[key],
);
---

{entries.map(([key, url]) => {
  const { label, svg, hrefPrefix } = ICONS[key];
  const href = hrefPrefix ? hrefPrefix + url : url;
  const external = !hrefPrefix;
  return (
    <a
      href={href}
      class={`${className} social-link social-link-${key}`}
      title={label}
      aria-label={label}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
      set:html={svg}
    />
  );
})}

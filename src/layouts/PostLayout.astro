---
import BaseLayout from './BaseLayout.astro';
import { readingTime } from '../utils/readingTime';

interface Props {
  title: string;
  date: string;
  description?: string;
  tags?: string[];
  cover?: string;
  body?: string;
}

const { title, date, description, tags = [], cover, body = '' } = Astro.props;

const formatted = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const rt = readingTime(body);
---

<BaseLayout title={title} description={description}>
  <!-- Reading progress bar -->
  <div id="progress-bar" class="progress-bar"></div>

  <article class="fade-in post-article">
    {cover && (
      <div class="post-cover">
        <img src={cover} alt={title} class="post-cover-img" />
        <div class="post-cover-overlay"></div>
      </div>
    )}

    <div class="post-container">
      <header class="post-header">
        <div class="post-meta-row">
          <time datetime={date}>{formatted}</time>
          <span>·</span>
          <span>{rt}</span>
          {tags.length > 0 && (
            <>
              <span>·</span>
              <div class="meta-tags">
                {tags.map(t => (
                  <a href={`/tags/${t}`} class="meta-tag">{t}</a>
                ))}
              </div>
            </>
          )}
        </div>
        <h1 class="post-title">{title}</h1>
        {description && <p class="post-desc">{description}</p>}
      </header>

      <div class="post-divider"></div>

      <div class="prose-blog">
        <slot />
      </div>

      <footer class="post-footer">
        {tags.length > 0 && (
          <div class="footer-tags">
            {tags.map(t => (
              <a href={`/tags/${t}`} class="footer-tag">{t}</a>
            ))}
          </div>
        )}
        <a href="/blog" class="back-link">← All writings</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<script>
  const bar = document.getElementById('progress-bar')!;
  const article = document.querySelector('.post-article') as HTMLElement;

  window.addEventListener('scroll', () => {
    const scrollTop = window.scrollY;
    const docHeight = article.offsetHeight - window.innerHeight;
    const pct = docHeight > 0 ? Math.min((scrollTop / docHeight) * 100, 100) : 0;
    bar.style.width = pct + '%';
  });
</script>

<style>
  .progress-bar {
    position: fixed; top: 0; left: 0; height: 2px; width: 0%;
    background: var(--color-accent); z-index: 100;
    transition: width .1s linear;
  }

  .post-article { padding-bottom: 5rem; }

  .post-cover {
    position: relative; width: 100%; height: 55vh; min-height: 320px;
    overflow: hidden; margin: 0 -1.5rem;
  }
  .post-cover-img {
    width: 100%; height: 100%; object-fit: cover;
  }
  .post-cover-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(248,245,240,.95) 100%);
  }

  .post-container { max-width: 42rem; margin: 0 auto; padding: 0 1.5rem; }

  .post-header { padding: 3rem 0 2rem; text-align: center; }

  .post-meta-row {
    display: flex; align-items: center; justify-content: center;
    gap: .5rem; flex-wrap: wrap;
    font-family: var(--font-sans); font-size: .72rem;
    color: var(--color-muted); letter-spacing: .04em; margin-bottom: 1.25rem;
  }
  .meta-tags { display: flex; gap: .35rem; }
  .meta-tag {
    color: var(--color-accent); text-decoration: none;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    padding: .15rem .45rem; border-radius: 2px;
    font-size: .62rem; letter-spacing: .1em; text-transform: uppercase;
    transition: background .2s;
  }
  .meta-tag:hover { background: color-mix(in srgb, var(--color-accent) 20%, transparent); }

  .post-title {
    font-family: var(--font-serif); font-size: clamp(1.875rem, 4vw, 2.75rem);
    font-weight: 500; line-height: 1.25; color: var(--color-ink); margin-bottom: .75rem;
  }
  .post-desc {
    font-family: var(--font-serif); font-size: 1.125rem; font-style: italic;
    color: var(--color-muted);
  }

  .post-divider {
    height: 1px; background: var(--color-border); margin-bottom: 3rem;
  }

  .post-footer {
    margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--color-border);
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
  }
  .footer-tags { display: flex; gap: .5rem; flex-wrap: wrap; }
  .footer-tag {
    font-family: var(--font-sans); font-size: .65rem; letter-spacing: .1em;
    text-transform: uppercase; color: var(--color-accent); text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    padding: .25rem .65rem; border-radius: 999px; transition: background .2s;
  }
  .footer-tag:hover { background: color-mix(in srgb, var(--color-accent) 10%, transparent); }
  .back-link {
    font-family: var(--font-sans); font-size: .75rem; color: var(--color-muted);
    text-decoration: none; letter-spacing: .1em; text-transform: uppercase;
    transition: color .2s;
  }
  .back-link:hover { color: var(--color-ink); }
</style>

---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: string;
  description?: string;
  tags?: string[];
}

const { title, date, description, tags = [] } = Astro.props;

const formatted = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout title={title} description={description}>
  <article class="max-w-2xl mx-auto py-16 fade-in">
    <header class="mb-12 text-center">
      <div class="flex items-center justify-center gap-3 mb-6 text-muted font-sans text-sm tracking-wider uppercase">
        <time datetime={date}>{formatted}</time>
        {tags.length > 0 && (
          <>
            <span>·</span>
            <span>{tags.join(' / ')}</span>
          </>
        )}
      </div>
      <h1 class="font-serif text-4xl font-medium leading-tight text-ink mb-4">{title}</h1>
      {description && (
        <p class="text-muted font-serif text-xl italic">{description}</p>
      )}
    </header>

    <div class="border-t border-border pt-12">
      <div class="prose-blog">
        <slot />
      </div>
    </div>

    <footer class="mt-16 pt-8 border-t border-border">
      <a href="/blog" class="font-sans text-sm text-muted hover:text-ink transition-colors tracking-wider uppercase">
        ← All writings
      </a>
    </footer>
  </article>
</BaseLayout>

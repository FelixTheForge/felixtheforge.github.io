---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: string;
  description?: string;
  tags?: string[];
}

const { title, date, description, tags = [] } = Astro.props;

const formatted = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout title={title} description={description}>
  <article class="fade-in" style="max-width:42rem; margin:0 auto; padding:4rem 0;">
    <header style="margin-bottom:3rem; text-align:center;">
      <div style="display:flex; align-items:center; justify-content:center; gap:0.75rem; margin-bottom:1.5rem; color:var(--color-muted); font-family:var(--font-sans); font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase;">
        <time datetime={date}>{formatted}</time>
        {tags.length > 0 && (
          <>
            <span>·</span>
            <span>{tags.join(' / ')}</span>
          </>
        )}
      </div>
      <h1 style="font-family:var(--font-serif); font-size:2.25rem; font-weight:500; line-height:1.3; color:var(--color-ink); margin-bottom:1rem;">{title}</h1>
      {description && (
        <p style="color:var(--color-muted); font-family:var(--font-serif); font-size:1.25rem; font-style:italic;">{description}</p>
      )}
    </header>

    <div style="border-top:1px solid var(--color-border); padding-top:3rem;">
      <div class="prose-blog">
        <slot />
      </div>
    </div>

    <footer style="margin-top:4rem; padding-top:2rem; border-top:1px solid var(--color-border);">
      <a href="/blog" class="back-link">← All writings</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .back-link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--color-ink); }
</style>

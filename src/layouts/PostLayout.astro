---
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';
import { readingTime } from '../utils/readingTime';
import { SITE } from '../config/site';

interface Heading { depth: number; slug: string; text: string; }
interface Props {
  title: string; date: string; description?: string;
  tags?: string[]; cover?: string; body?: string;
  headings?: Heading[];
}
const { title, date, description, tags=[], cover, body='', headings=[] } = Astro.props;
const rt = readingTime(body);
const formatted = new Date(date).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'});

// TOC: only show when there are at least 3 H2/H3 headings
const tocItems = headings.filter(h => h.depth === 2 || h.depth === 3);
const showToc = tocItems.length >= 3;
---

<BaseLayout
  title={title}
  description={description || `${title} — ${SITE.title}`}
  ogImage={cover}
  ogType="article"
  publishedTime={new Date(date).toISOString()}
  tags={tags}
>
  <div id="reading-bar"></div>

  {/* JSON-LD structured data for rich search results */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: description,
    image: cover ? (cover.startsWith('http') ? cover : (Astro.site?.toString().replace(/\/$/, '') ?? '') + cover) : undefined,
    datePublished: new Date(date).toISOString(),
    dateModified: new Date(date).toISOString(),
    author: {
      '@type': 'Person',
      name: SITE.title,
      url: SITE.url,
    },
    publisher: {
      '@type': 'Person',
      name: SITE.title,
      url: SITE.url,
    },
    keywords: tags.join(', '),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': (Astro.site?.toString().replace(/\/$/, '') ?? '') + Astro.url.pathname,
    },
  })}/>

  <article class="post-article">
    {cover && (
      <div class="post-hero">
        <img src={cover} alt={title} class="post-hero-img"/>
        <div class="post-hero-fade"></div>
      </div>
    )}

    <div class="post-layout">

      <!-- ── Mini sidebar (desktop only) ── -->
      <aside class="post-sidebar">
        <div class="sidebar-inner">
          <img src={SITE.avatar} alt={SITE.title} class="sb-avatar"/>
          <p class="sb-label">Written by</p>
          <p class="sb-name">{SITE.title}</p>
          <p class="sb-role">{SITE.role}</p>
          <div class="sb-divider"></div>
          <div class="sb-meta">
            <p class="sb-date">{formatted}</p>
            <p class="sb-rt">{rt}</p>
          </div>
          {showToc && (
            <>
              <div class="sb-divider"></div>
              <nav class="sb-toc" aria-label="Table of contents">
                <p class="sb-toc-label" data-i18n="toc.label">On this page</p>
                <ul class="sb-toc-list">
                  {tocItems.map(h => (
                    <li class={`sb-toc-item sb-toc-d${h.depth}`}>
                      <a href={`#${h.slug}`} class="sb-toc-link" data-toc-slug={h.slug}>
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </>
          )}
          <div class="sb-divider"></div>
          <div class="sb-actions">
            {SITE.social.github && (
              <a href={SITE.social.github} target="_blank" rel="noopener" class="sb-btn" title="GitHub">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
              </a>
            )}
            <button id="copy-link-btn" class="sb-btn" title="Copy link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </button>
            <a href="/blog" class="sb-btn" title="All posts">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            </a>
          </div>
        </div>
      </aside>

      <div class="post-container">
        <header class="post-header fade-up">
          <div class="post-tags">
            {tags.map(t => <a href={`/tags/${t}`} class="pill">{t}</a>)}
          </div>
          <h1 class="post-title">{title}</h1>
          {description && <p class="post-desc">{description}</p>}
          <div class="post-meta">
            <time>{formatted}</time>
            <span class="meta-dot">·</span>
            <span>{rt}</span>
          </div>
        </header>

        <div class="post-divider"></div>

        <div class="prose fade-up" data-pagefind-body style="animation-delay:.1s">
          <slot />
        </div>

        <footer class="post-footer">
          <div class="footer-tags">
            {tags.map(t => <a href={`/tags/${t}`} class="pill">{t}</a>)}
          </div>
          <a href="/blog" class="back-btn">← All posts</a>
        </footer>
      </div>
    </div>
  </article>

  <Comments />
</BaseLayout>

<script>
  const bar = document.getElementById('reading-bar')!;
  window.addEventListener('scroll', () => {
    const h = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';
  });

  // Copy link button
  const copyBtn = document.getElementById('copy-link-btn');
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      copyBtn.classList.add('copied');
      setTimeout(() => copyBtn.classList.remove('copied'), 1500);
    } catch {}
  });

  // ─── TOC: active-section highlight + smooth scroll ───
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.sb-toc-link');
  if (tocLinks.length) {
    const tocBySlug = new Map<string, HTMLAnchorElement>();
    tocLinks.forEach(a => tocBySlug.set(a.dataset.tocSlug!, a));

    // Collect all heading elements that are in the TOC
    const targets: HTMLElement[] = [];
    tocBySlug.forEach((_, slug) => {
      const h = document.getElementById(slug);
      if (h) targets.push(h);
    });

    let activeSlug = '';
    function setActive(slug: string) {
      if (slug === activeSlug) return;
      if (activeSlug) tocBySlug.get(activeSlug)?.classList.remove('active');
      tocBySlug.get(slug)?.classList.add('active');
      activeSlug = slug;
    }

    const io = new IntersectionObserver(entries => {
      // Find the topmost heading currently visible above the fold (~25% from top)
      const visible = entries
        .filter(e => e.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible.length) {
        setActive(visible[0].target.id);
      } else {
        // No heading visible — find the last one passed
        const passed = targets.filter(el => el.getBoundingClientRect().top < 100);
        if (passed.length) setActive(passed[passed.length - 1].id);
      }
    }, {
      rootMargin: '-80px 0px -65% 0px',  // upper line at navbar bottom, lower at 35% of viewport
      threshold: 0,
    });
    targets.forEach(t => io.observe(t));

    // Smooth scroll on click
    tocLinks.forEach(a => {
      a.addEventListener('click', (e) => {
        const slug = a.dataset.tocSlug!;
        const target = document.getElementById(slug);
        if (!target) return;
        e.preventDefault();
        const top = target.getBoundingClientRect().top + window.scrollY - 88;
        window.scrollTo({ top, behavior: 'smooth' });
        history.pushState(null, '', `#${slug}`);
      });
    });
  }
</script>

<style>
  #reading-bar {
    position: fixed; top: 0; left: 0; height: 3px; width: 0;
    background: var(--grad-1); z-index: 200; border-radius: 0 2px 2px 0;
    transition: width .1s linear;
  }

  .post-article { padding-bottom: 6rem; }

  .post-hero {
    position: relative; width: 100%; height: 50vh; min-height: 300px;
    overflow: hidden;
  }
  .post-hero-img { width: 100%; height: 100%; object-fit: cover; }
  .post-hero-fade {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, transparent 30%, var(--bg) 100%);
  }

  /* ── Layout: sidebar + content ── */
  .post-layout {
    max-width: 72rem; margin: 0 auto;
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 2rem;
    padding: 0 1.5rem;
  }
  .post-container { max-width: 46rem; padding: 0; }

  /* ── Sidebar ── */
  .post-sidebar {
    padding-top: 4rem;
  }
  .sidebar-inner {
    position: sticky; top: 96px;
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
    padding: 1.5rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow:
      0 1px 2px rgba(0,0,0,.04),
      0 4px 12px rgba(0,0,0,.05),
      inset 0 1px 0 rgba(255,255,255,.6);
  }
  [data-theme="dark"] .sidebar-inner {
    box-shadow:
      0 1px 2px rgba(0,0,0,.4),
      0 4px 12px rgba(0,0,0,.4),
      inset 0 1px 0 rgba(255,255,255,.04);
  }

  .sb-avatar {
    width: 64px; height: 64px; border-radius: 50%; object-fit: cover;
    border: 3px solid var(--bg-card);
    box-shadow: 0 0 0 2px var(--accent), 0 6px 16px rgba(0,113,227,.25);
    margin-bottom: .875rem;
  }
  .sb-label {
    font-size: .65rem; font-weight: 600; letter-spacing: .12em;
    text-transform: uppercase; color: var(--ink-4);
    margin-bottom: .15rem;
  }
  .sb-name {
    font-size: .9375rem; font-weight: 700;
    color: var(--ink); letter-spacing: -.01em;
    margin-bottom: .15rem;
  }
  .sb-role {
    font-size: .7rem; font-weight: 500; color: var(--accent);
  }

  .sb-divider {
    width: 32px; height: 1px;
    background: var(--border);
    margin: 1rem 0;
  }

  .sb-meta { display: flex; flex-direction: column; gap: .15rem; }
  .sb-date { font-size: .7rem; color: var(--ink-2); font-weight: 500; }
  .sb-rt   { font-size: .65rem; color: var(--ink-4); }

  /* ── TOC ── */
  .sb-toc {
    width: 100%;
    text-align: left;
    max-height: 50vh;
    overflow-y: auto;
    /* hide scrollbar but keep scrollable */
    scrollbar-width: thin;
  }
  .sb-toc::-webkit-scrollbar { width: 3px; }
  .sb-toc::-webkit-scrollbar-thumb { background: var(--border); border-radius: 99px; }
  .sb-toc-label {
    font-size: .65rem; font-weight: 600;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--ink-4);
    margin-bottom: .65rem;
  }
  .sb-toc-list {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: .15rem;
    position: relative;
  }
  .sb-toc-list::before {
    content: '';
    position: absolute;
    left: 6px; top: 0; bottom: 0;
    width: 1px;
    background: var(--border);
  }
  .sb-toc-item { position: relative; }
  .sb-toc-d3 { padding-left: 1rem; }
  .sb-toc-link {
    display: block;
    position: relative;
    font-size: .75rem;
    line-height: 1.5;
    color: var(--ink-3);
    text-decoration: none;
    padding: .25rem 0 .25rem .85rem;
    border-radius: 4px;
    transition: color .15s;
  }
  .sb-toc-link::before {
    content: '';
    position: absolute;
    left: 0; top: 50%; transform: translateY(-50%);
    width: 1px; height: 0;
    background: var(--accent);
    border-radius: 2px;
    transition: height .2s;
  }
  .sb-toc-link:hover { color: var(--ink); }
  .sb-toc-link.active {
    color: var(--accent);
    font-weight: 600;
  }
  .sb-toc-link.active::before {
    height: 16px;
    width: 2px;
  }

  .sb-actions {
    display: flex; gap: .375rem; align-items: center;
  }
  .sb-btn {
    width: 30px; height: 30px;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--ink-3);
    cursor: pointer;
    text-decoration: none;
    transition: all .2s;
  }
  .sb-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0,113,227,.3);
  }
  .sb-btn.copied {
    background: var(--accent-2);
    border-color: var(--accent-2);
    color: #fff;
  }

  @media (max-width: 900px) {
    .post-layout { grid-template-columns: 1fr; max-width: 46rem; }
    .post-sidebar { display: none; }
  }

  .post-header { padding: 3rem 0 2rem; }
  .post-tags { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1.25rem; }

  .post-title {
    font-size: clamp(1.875rem,4vw,2.75rem); font-weight: 700;
    color: var(--ink); letter-spacing: -.03em; line-height: 1.2; margin-bottom: 1rem;
  }
  .post-desc {
    font-size: 1.125rem; color: var(--ink-3); line-height: 1.65; margin-bottom: 1.25rem;
  }
  .post-meta {
    display: flex; align-items: center; gap: .5rem;
    font-size: .875rem; color: var(--ink-4); font-weight: 500;
  }
  .meta-dot { color: var(--ink-4); }

  .post-divider {
    height: 1px; background: var(--border); margin-bottom: 2.5rem;
  }

  .post-footer {
    margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
  }
  .footer-tags { display: flex; gap: .5rem; flex-wrap: wrap; }
  .back-btn {
    font-size: .875rem; font-weight: 500; color: var(--accent);
    text-decoration: none; transition: opacity .2s;
  }
  .back-btn:hover { opacity: .7; }
</style>

---
import '../styles/global.css';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description?: string;
  heroHeader?: boolean;
}

const { title, description = `${SITE.title} — personal writings`, heroHeader = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function() {
        const t = localStorage.getItem('theme') || 'light';
        const l = localStorage.getItem('lang') || 'en';
        document.documentElement.setAttribute('data-theme', t);
        document.documentElement.setAttribute('data-lang', l);
        document.documentElement.lang = l === 'zh' ? 'zh' : 'en';
      })();
    </script>
  </head>
  <body>
    <header class={heroHeader ? 'site-header hero-mode' : 'site-header page-mode'}>
      <nav class="nav-inner">
        <a href="/" class="site-logo">
          {SITE.title.replace('TheForge', '')}<span class="logo-accent">TheForge</span>
        </a>

        <ul class="nav-links">
          <li><a href="/" class="nav-link" data-i18n="nav.home">Home</a></li>
          <li><a href="/blog" class="nav-link" data-i18n="nav.writing">Writing</a></li>
          <li><a href="/tags" class="nav-link" data-i18n="nav.tags">Tags</a></li>
          <li><a href="/about" class="nav-link" data-i18n="nav.about">About</a></li>
        </ul>

        <div class="nav-controls">
          <!-- Language toggle -->
          <button id="lang-toggle" class="ctrl-btn" title="切换语言 / Switch language" aria-label="Toggle language">
            <span class="lang-label" id="lang-label">EN</span>
          </button>

          <!-- Theme toggle -->
          <button id="theme-toggle" class="ctrl-btn" title="Toggle theme" aria-label="Toggle dark mode">
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main class={heroHeader ? 'main-hero' : 'main-page'}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span class="footer-copy">© {new Date().getFullYear()} {SITE.title}</span>
        <span class="footer-ornament">✦</span>
        <div class="footer-links">
          {SITE.social.github && (
            <a href={SITE.social.github} target="_blank" rel="noopener" class="footer-link" data-i18n="footer.github">GitHub</a>
          )}
          <a href="/rss.xml" class="footer-link">RSS</a>
          <a href="/tags" class="footer-link" data-i18n="nav.tags">Tags</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  import { UI, type Lang } from '../config/i18n';

  // ── i18n ──
  function applyLang(lang: Lang) {
    document.documentElement.setAttribute('data-lang', lang);
    document.documentElement.lang = lang === 'zh' ? 'zh' : 'en';
    localStorage.setItem('lang', lang);

    const label = document.getElementById('lang-label');
    if (label) label.textContent = lang === 'zh' ? '中' : 'EN';

    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n')!;
      const parts = key.split('.');
      let val: any = UI[lang];
      for (const p of parts) val = val?.[p];
      if (val) el.textContent = val;
    });
  }

  const langToggle = document.getElementById('lang-toggle')!;
  langToggle.addEventListener('click', () => {
    const current = (localStorage.getItem('lang') || 'en') as Lang;
    applyLang(current === 'en' ? 'zh' : 'en');
  });

  // Apply saved language on load
  applyLang((localStorage.getItem('lang') || 'en') as Lang);

  // ── Dark mode ──
  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
  }

  document.getElementById('theme-toggle')!.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    applyTheme(current === 'dark' ? 'light' : 'dark');
  });
</script>

<style>
  /* ── Header ── */
  .site-header { z-index: 20; padding: 1.25rem 1.5rem; }

  .hero-mode {
    position: absolute; top: 0; left: 0; right: 0;
  }
  .hero-mode .site-logo { color: #fff; text-shadow: 0 1px 8px rgba(0,0,0,.3); }
  .hero-mode .logo-accent { color: #a8c5a0; }
  .hero-mode .nav-link { color: rgba(255,255,255,.65); }
  .hero-mode .nav-link:hover { color: #fff; }
  .hero-mode .ctrl-btn { color: rgba(255,255,255,.7); border-color: rgba(255,255,255,.2); }
  .hero-mode .ctrl-btn:hover { color: #fff; border-color: rgba(255,255,255,.5); }

  .page-mode {
    position: relative;
    border-bottom: 1px solid var(--color-border);
  }
  .page-mode .site-logo { color: var(--color-ink); }
  .page-mode .logo-accent { color: var(--color-accent); }
  .page-mode .nav-link { color: var(--color-muted); }
  .page-mode .nav-link:hover { color: var(--color-ink); }
  .page-mode .ctrl-btn { color: var(--color-muted); border-color: var(--color-border); }
  .page-mode .ctrl-btn:hover { color: var(--color-ink); border-color: var(--color-muted); }

  .nav-inner {
    max-width: 56rem; margin: 0 auto;
    display: flex; align-items: center; gap: 1.5rem;
  }

  .site-logo {
    font-family: var(--font-serif); font-size: 1.1rem; letter-spacing: .04em;
    text-decoration: none; transition: opacity .2s; flex-shrink: 0;
  }

  .nav-links {
    display: flex; gap: 1.5rem; list-style: none; margin: 0; padding: 0; flex: 1;
  }
  .nav-link {
    font-family: var(--font-sans); font-size: .68rem; text-decoration: none;
    letter-spacing: .12em; text-transform: uppercase; transition: color .2s;
  }

  .nav-controls { display: flex; align-items: center; gap: .5rem; }

  .ctrl-btn {
    display: flex; align-items: center; justify-content: center;
    width: 2rem; height: 2rem; border-radius: 4px;
    background: transparent; border: 1px solid; cursor: pointer;
    transition: color .2s, border-color .2s, background .2s;
  }
  .ctrl-btn:hover { background: rgba(128,128,128,.1); }

  .lang-label { font-family: var(--font-sans); font-size: .65rem; font-weight: 600; letter-spacing: .05em; }

  /* Show/hide sun-moon based on theme */
  :root[data-theme="light"] .icon-moon { display: none; }
  :root[data-theme="dark"]  .icon-sun  { display: none; }

  /* ── Main ── */
  .main-hero { flex: 1; padding: 0; }
  .main-page { flex: 1; padding: 0 1.5rem; }

  body { min-height: 100vh; display: flex; flex-direction: column; }

  /* ── Footer ── */
  .site-footer {
    padding: 2.5rem 1.5rem; margin-top: 4rem;
    border-top: 1px solid var(--color-border);
  }
  .footer-inner {
    max-width: 56rem; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between;
  }
  .footer-copy { font-family: var(--font-sans); font-size: .75rem; color: var(--color-muted); }
  .footer-ornament { color: var(--color-muted); font-size: .75rem; }
  .footer-links { display: flex; gap: 1.25rem; }
  .footer-link {
    font-family: var(--font-sans); font-size: .72rem; color: var(--color-muted);
    text-decoration: none; letter-spacing: .06em; transition: color .2s;
  }
  .footer-link:hover { color: var(--color-ink); }
</style>

---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'FelixTheForge — personal writings' } = Astro.props;
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="py-10 px-6">
      <nav class="max-w-2xl mx-auto flex items-center justify-between">
        <a href="/" class="font-serif text-lg tracking-wide hover:text-accent transition-colors">
          Felix<span class="text-accent">TheForge</span>
        </a>
        <ul class="flex gap-8 font-sans text-sm text-muted tracking-wider uppercase">
          <li><a href="/" class="hover:text-ink transition-colors">Home</a></li>
          <li><a href="/blog" class="hover:text-ink transition-colors">Writing</a></li>
          <li><a href="/about" class="hover:text-ink transition-colors">About</a></li>
        </ul>
      </nav>
    </header>

    <main class="flex-1 px-6">
      <slot />
    </main>

    <footer class="py-12 px-6 mt-20 border-t border-border">
      <div class="max-w-2xl mx-auto flex items-center justify-between text-sm text-muted font-sans">
        <span>© {new Date().getFullYear()} FelixTheForge</span>
        <span class="tracking-widest text-xs">✦</span>
        <a
          href="https://github.com/FelixTheForge"
          target="_blank"
          rel="noopener"
          class="hover:text-ink transition-colors"
        >GitHub</a>
      </div>
    </footer>
  </body>
</html>

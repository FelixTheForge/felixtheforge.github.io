---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { SITE } from '../config/site';
---
<BaseLayout title="About — FelixTheForge">
  <PageBanner
    title="About"
    subtitle="Builder, thinker, occasional writer."
    image="https://images.unsplash.com/photo-1519681393784-d120267933ba?w=1400&q=80"
    tint="rgba(15,20,30,.58)"
  />
  <div class="fade-in about-wrap">

    <!-- Hero -->
    <div class="about-hero">
      <img
        src={SITE.avatar}
        alt="Felix"
        class="avatar"
      />
      <div class="about-intro">
        <p class="about-tag">About me</p>
        <h1 class="about-name">Felix<span class="accent">TheForge</span></h1>
        <p class="about-bio" id="about-bio-text">{SITE.bioEn}</p>
        <div class="about-links">
          <a href="https://github.com/FelixTheForge" target="_blank" rel="noopener" class="alink">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            GitHub
          </a>
          <a href="/rss.xml" class="alink">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1" fill="currentColor"/></svg>
            RSS
          </a>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <!-- Story -->
    <div class="prose-blog story">
      <h2>The longer version</h2>
      <p>
        I've been building things on the internet for as long as I can remember. What started as
        curiosity — how does this website work? — became a practice, then a craft, then a way of thinking.
      </p>
      <p>
        This blog is where I put the things I'm working through. Not polished essays — more like
        notes from the workshop. Sometimes about code, sometimes about process, sometimes about
        whatever's been catching my attention.
      </p>
      <p>
        I believe in the value of making things slowly and carefully. In returning to first principles.
        In writing as a tool for thinking.
      </p>
    </div>

    <div class="divider"></div>

    <!-- What I'm into -->
    <div class="interests">
      <h2 class="interests-title">Currently into</h2>
      <div class="interests-grid">
        {[
          { icon: '⌨️', label: 'TypeScript', desc: 'Type systems as documentation' },
          { icon: '🌿', label: 'Astro', desc: 'The right tool for content sites' },
          { icon: '📖', label: 'Long-form reading', desc: 'Books, essays, slow media' },
          { icon: '🏔️', label: 'Mountains', desc: 'Any chance I get' },
        ].map(item => (
          <div class="interest-card">
            <span class="interest-icon">{item.icon}</span>
            <div>
              <div class="interest-label">{item.label}</div>
              <div class="interest-desc">{item.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .about-wrap { max-width: 42rem; margin: 0 auto; padding: 4rem 0 6rem; }

  .about-hero { display: flex; align-items: center; gap: 3rem; margin-bottom: 3rem; }
  .avatar { width: 7rem; height: 7rem; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 3px solid var(--color-border); }
  .about-tag { font-family: var(--font-sans); font-size: .65rem; letter-spacing: .25em; text-transform: uppercase; color: var(--color-muted); margin-bottom: .5rem; }
  .about-name { font-family: var(--font-serif); font-size: 2.25rem; font-weight: 500; margin-bottom: .75rem; }
  .accent { color: var(--color-accent); }
  .about-bio { font-family: var(--font-serif); font-size: 1.05rem; color: var(--color-muted); line-height: 1.7; margin-bottom: 1.25rem; }
  .about-links { display: flex; gap: 1rem; }
  .alink {
    display: flex; align-items: center; gap: .4rem;
    font-family: var(--font-sans); font-size: .75rem; letter-spacing: .08em;
    color: var(--color-ink); text-decoration: none;
    border: 1px solid var(--color-border); padding: .4rem .9rem; border-radius: 2px;
    transition: border-color .2s, color .2s;
  }
  .alink:hover { border-color: var(--color-accent); color: var(--color-accent); }

  .divider { height: 1px; background: var(--color-border); margin: 3rem 0; }

  .story h2 { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 500; margin-bottom: 1.25rem; }

  .interests-title { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 500; margin-bottom: 1.5rem; }
  .interests-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .interest-card {
    display: flex; align-items: flex-start; gap: .9rem;
    padding: 1.25rem; border: 1px solid var(--color-border); border-radius: 4px;
    background: color-mix(in srgb, var(--color-parchment) 50%, white);
    transition: border-color .2s, transform .2s;
  }
  .interest-card:hover { border-color: var(--color-accent); transform: translateY(-2px); }
  .interest-icon { font-size: 1.5rem; }
  .interest-label { font-family: var(--font-sans); font-size: .8rem; font-weight: 500; color: var(--color-ink); letter-spacing: .05em; margin-bottom: .2rem; }
  .interest-desc { font-family: var(--font-serif); font-size: .875rem; color: var(--color-muted); font-style: italic; }

  @media (max-width: 500px) {
    .about-hero { flex-direction: column; text-align: center; }
    .about-links { justify-content: center; }
    .interests-grid { grid-template-columns: 1fr; }
  }
</style>

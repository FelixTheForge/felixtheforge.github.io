---
import BaseLayout from '../layouts/BaseLayout.astro';
import Socials from '../components/Socials.astro';
import { SITE } from '../config/site';
---
<BaseLayout title={`About — ${SITE.title}`}>

  <!-- ── Atmospheric background ── -->
  <div class="page-bg-wrap" aria-hidden="true">
    <div class="page-bg" style={`background-image:url('${SITE.aboutBg}')`}></div>
    <div class="page-bg-fade"></div>
  </div>

  <div class="page-wrap">

    <!-- ── Motto ── -->
    <blockquote class="motto fade-up">
      <span class="motto-quote-mark">"</span>
      <p class="motto-text" id="motto-text">{SITE.mottoEn}</p>
      <p class="motto-source" id="motto-source">{SITE.mottoSourceEn}</p>
    </blockquote>

    <div class="profile-card card fade-up" style="animation-delay:.1s">
      <div class="profile-top">
        <img src={SITE.avatar} alt={SITE.title} class="avatar"/>
        <div>
          <h1 class="name">{SITE.title}</h1>
          <p class="role">{SITE.role}</p>
          <p class="location">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            {SITE.location}
          </p>
        </div>
      </div>
      <p class="bio" id="about-bio">{SITE.bioEn}</p>
      <div class="social-section">
        <p class="social-label" data-zh="在以下平台找到我">Find me on</p>
        <div class="social-row">
          <Socials className="about-social-btn" />
          <a href="/rss.xml" class="about-social-btn" title="RSS feed" aria-label="RSS">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1" fill="currentColor"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="content-grid fade-up" style="animation-delay:.15s">
      <section class="text-section">
        <h2 class="section-title">The longer version</h2>
        <div class="prose">
          <p>I've been building things on the internet for as long as I can remember. What started as curiosity became a practice, then a craft, then a way of thinking.</p>
          <p>This blog is where I put the things I'm working through. Not polished essays — more like notes from the workshop.</p>
          <p>I believe in making things slowly and carefully. In returning to first principles. In writing as a tool for thinking.</p>
        </div>
      </section>

      <section class="interests-section">
        <h2 class="section-title">Currently into</h2>
        <div class="interests">
          {[
            {icon:'⌨️', label:'TypeScript', desc:'Types as documentation'},
            {icon:'🚀', label:'Astro',      desc:'Right tool for content'},
            {icon:'📖', label:'Long reads', desc:'Books, essays, slow media'},
            {icon:'🏔️', label:'Mountains',  desc:'Any chance I get'},
            {icon:'🎵', label:'Music',      desc:'Always in the background'},
            {icon:'☕', label:'Coffee',     desc:'A necessary constant'},
          ].map(item => (
            <div class="interest-item card">
              <span class="interest-icon">{item.icon}</span>
              <div>
                <p class="interest-label">{item.label}</p>
                <p class="interest-desc">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>

  </div>
</BaseLayout>

<script>
  import { SITE } from '../config/site';
  function syncBio() {
    const lang = localStorage.getItem('lang') || 'en';
    const bio = document.getElementById('about-bio');
    if (bio) bio.textContent = lang === 'zh' ? SITE.bioZh : SITE.bioEn;
    const motto = document.getElementById('motto-text');
    if (motto) motto.textContent = lang === 'zh' ? SITE.mottoZh : SITE.mottoEn;
    const src = document.getElementById('motto-source');
    if (src) src.textContent = lang === 'zh' ? SITE.mottoSourceZh : SITE.mottoSourceEn;
    // Generic data-zh swap for any other static element
    document.querySelectorAll('[data-zh]').forEach(el => {
      const h = el as HTMLElement;
      if (!h.dataset.en) h.dataset.en = h.textContent || '';
      h.textContent = lang === 'zh' ? (h.dataset.zh || '') : (h.dataset.en || '');
    });
  }
  syncBio();
  document.getElementById('lang-btn')?.addEventListener('click', () => setTimeout(syncBio, 0));
  document.addEventListener('astro:after-swap', syncBio);
</script>

<style>
  /* ── Atmospheric background ── */
  .page-bg-wrap {
    position: absolute; top: 0; left: 0; right: 0;
    height: 60vh;
    z-index: 0; pointer-events: none;
    overflow: hidden;
  }
  .page-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    filter: saturate(.9);
    animation: bgDrift 30s ease-in-out infinite alternate;
  }
  @keyframes bgDrift {
    from { transform: scale(1.02) translateY(0); }
    to   { transform: scale(1.08) translateY(-2%); }
  }
  .page-bg-fade {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg,
        rgba(240,242,248,.5) 0%,
        rgba(240,242,248,.75) 50%,
        var(--bg) 100%);
  }
  [data-theme="dark"] .page-bg-fade {
    background:
      linear-gradient(180deg,
        rgba(9,9,15,.55) 0%,
        rgba(9,9,15,.8) 50%,
        var(--bg) 100%);
  }
  [data-theme="dark"] .page-bg { filter: brightness(.55) saturate(.85); }

  .page-wrap {
    position: relative; z-index: 1;
    max-width: 56rem; margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }

  /* ── Motto ── */
  .motto {
    position: relative;
    text-align: center;
    padding: 2.5rem 1.5rem 2rem;
    margin: 0 0 2.5rem;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg,
      rgba(0,113,227,.06) 0%,
      rgba(191,90,242,.06) 50%,
      rgba(255,159,10,.05) 100%);
    border: 1px solid rgba(0,113,227,.1);
  }
  .motto::before, .motto::after {
    content: '';
    position: absolute; left: 50%; transform: translateX(-50%);
    width: 60px; height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: .5;
  }
  .motto::before { top: .75rem; }
  .motto::after  { bottom: .75rem; }

  .motto-quote-mark {
    position: absolute; top: -.5rem; left: 1.5rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 6rem; line-height: 1;
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent), var(--accent-4));
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: .25;
    pointer-events: none;
  }

  .motto-text {
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    line-height: 1.85;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: .02em;
    white-space: pre-line;
    font-family: 'Georgia', 'Songti SC', 'STSong', serif;
    font-style: italic;
  }
  /* When lang is Chinese, swap to a serif Chinese stack and lose italic */
  html[data-lang="zh"] .motto-text {
    font-family: 'STKaiti', 'KaiTi', 'Songti SC', 'STSong', 'SimSun', serif;
    font-style: normal;
    letter-spacing: .15em;
  }

  .motto-source {
    margin-top: 1rem;
    font-size: .8125rem;
    color: var(--ink-3);
    letter-spacing: .05em;
    font-style: italic;
  }
  html[data-lang="zh"] .motto-source {
    font-family: 'STKaiti', 'KaiTi', 'Songti SC', serif;
    font-style: normal;
  }

  .profile-card { padding: 2.5rem; margin-bottom: 2rem; border-radius: var(--radius-xl); }
  .profile-top { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.25rem; }
  .avatar { width: 6rem; height: 6rem; border-radius: 50%; object-fit: cover; border: 3px solid var(--border); box-shadow: var(--shadow-md); flex-shrink: 0; }
  .name { font-size: 1.5rem; font-weight: 700; letter-spacing: -.025em; color: var(--ink); margin-bottom: .25rem; }
  .role { font-size: .9375rem; font-weight: 500; color: var(--accent); margin-bottom: .375rem; }
  .location { display: flex; align-items: center; gap: .375rem; font-size: .8125rem; color: var(--ink-3); }
  .bio { font-size: 1rem; color: var(--ink-2); line-height: 1.7; margin-bottom: 1.5rem; }
  .social-section { display: flex; flex-direction: column; gap: .85rem; }
  .social-label {
    font-size: .7rem; font-weight: 700;
    letter-spacing: .15em; text-transform: uppercase;
    color: var(--ink-3);
  }
  .social-row {
    display: flex;
    gap: .55rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .about-social-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;
    color: var(--ink-2);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration: none;
    transition: background .15s, border-color .15s, color .15s, transform .15s, box-shadow .15s;
  }
  .about-social-btn svg { width: 18px; height: 18px; }
  .about-social-btn:hover {
    background: var(--bg-elevated);
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0,113,227,.15);
  }

  .content-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .text-section, .interests-section { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 2rem; box-shadow: var(--shadow-sm); }
  .section-title { font-size: 1.125rem; font-weight: 700; color: var(--ink); letter-spacing: -.02em; margin-bottom: 1.25rem; }

  .interests { display: flex; flex-direction: column; gap: .625rem; }
  .interest-item { display: flex; align-items: center; gap: .875rem; padding: .875rem 1rem; border-radius: var(--radius-md); }
  .interest-icon { font-size: 1.375rem; flex-shrink: 0; }
  .interest-label { font-size: .9rem; font-weight: 600; color: var(--ink); margin-bottom: .1rem; }
  .interest-desc { font-size: .78rem; color: var(--ink-3); }

  @media (max-width: 640px) {
    .profile-top { flex-direction: column; text-align: center; }
    .social-row { justify-content: center; }
    .content-grid { grid-template-columns: 1fr; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — FelixTheForge">
  <div class="max-w-2xl mx-auto py-16 fade-in">
    <header class="mb-16">
      <h1 class="font-serif text-4xl font-medium mb-3">About</h1>
    </header>

    <div class="prose-blog">
      <p>
        I'm Felix. I build things, break things, and occasionally write about it.
      </p>

      <p>
        This is my personal corner of the internet — a place to think out loud about
        technology, craft, and whatever else catches my attention.
      </p>

      <hr />

      <p>
        You can find me on <a href="https://github.com/FelixTheForge" target="_blank" rel="noopener">GitHub</a>.
      </p>
    </div>
  </div>
</BaseLayout>

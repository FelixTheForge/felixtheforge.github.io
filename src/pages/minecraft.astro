---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MINECRAFT } from '../config/site';
---
<BaseLayout title={`${MINECRAFT.name} — Minecraft Community`}>

  <div class="mc-root">

    <!-- ═══════════════ HERO ═══════════════ -->
    <section class="mc-hero">
      <div class="mc-hero-bg" style={`background-image:url('${MINECRAFT.bannerImg}')`}></div>
      <div class="mc-hero-overlay"></div>

      <!-- Floating decorative pixel blocks -->
      <div class="mc-float-blocks" aria-hidden="true">
        <div class="mc-fb mc-fb-1">⛏</div>
        <div class="mc-fb mc-fb-2">🟩</div>
        <div class="mc-fb mc-fb-3">💎</div>
        <div class="mc-fb mc-fb-4">🟫</div>
        <div class="mc-fb mc-fb-5">⚒</div>
      </div>

      <div class="mc-hero-inner">
        <div class="mc-pix-tag">
          <span class="mc-block-square"></span>
          <span>LIVE · {MINECRAFT.mcVersion}</span>
          <span class="mc-status-dot"></span>
        </div>

        <h1 class="mc-title">{MINECRAFT.name}</h1>

        <p class="mc-tagline" id="mc-tagline">{MINECRAFT.tagline}</p>

        <!-- Feature tags row — instant "what we're about" -->
        <div class="mc-feat-tags">
          {MINECRAFT.tags.map((t,i) => (
            <span class="mc-feat-tag" data-zh={MINECRAFT.tagsZh[i]}>{t}</span>
          ))}
        </div>

        <!-- Highlights — community at a glance -->
        <div class="mc-highlights">
          {MINECRAFT.highlights.map(h => {
            const isOnline = h.label === 'Online';
            return (
              <div class="mc-hl">
                <span class="mc-hl-value" data-mc-online={isOnline ? 'true' : undefined}>{h.value}</span>
                <span class="mc-hl-label" data-zh={h.labelZh}>{h.label}</span>
              </div>
            );
          })}
        </div>

        <!-- Join card (QQ group + QR) -->
        <div class="mc-join">
          <div class="mc-join-info">
            <p class="mc-join-label" data-i18n-mc="join-label">JOIN OUR QQ GROUP</p>
            <p class="mc-group-no">{MINECRAFT.qqGroup}</p>
            <div class="mc-join-actions">
              <button id="copy-qq-btn" class="mc-btn mc-btn-green">
                <span class="mc-btn-icon">⎘</span>
                <span data-i18n-mc="copy">COPY</span>
              </button>
              <a href="#gallery" class="mc-btn mc-btn-dark">
                <span data-i18n-mc="explore">EXPLORE</span>
              </a>
            </div>
          </div>
          <div class="mc-qr">
            <img src={MINECRAFT.qrCode} alt="QQ group QR"
                 onerror="this.style.display='none';this.parentElement.classList.add('no-qr');"/>
            <span class="mc-qr-fallback">
              <span class="mc-pix-grid"></span>
              <em data-i18n-mc="qr-fallback">put qq-group-qr.png in /public/minecraft/</em>
            </span>
            <p class="mc-qr-label" data-i18n-mc="scan">SCAN TO JOIN</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════ GALLERY ═══════════════ -->
    <section id="gallery" class="mc-section">
      <header class="mc-section-head">
        <h2 class="mc-h2" data-i18n-mc="gallery-h">SCREENSHOTS</h2>
        <p class="mc-section-sub" data-i18n-mc="gallery-sub">Moments from our world.</p>
      </header>

      <div class="mc-gallery">
        {MINECRAFT.gallery.map(g => (
          <a href={g.full} target="_blank" rel="noopener" class="mc-shot">
            <img src={g.thumb} alt={g.caption} loading="lazy" decoding="async" width="640" height="400"/>
            <div class="mc-shot-overlay">
              <span class="mc-shot-caption">{g.caption}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ═══════════════ PITCH — "What we are" ═══════════════ -->
    <section class="mc-pitch-section">
      <div class="mc-pitch-grid">
        {MINECRAFT.pitch.map(p => (
          <div class="mc-pitch-card">
            <div class="mc-pitch-icon">{p.icon}</div>
            <h3 class="mc-pitch-title" data-zh={p.titleZh}>{p.title}</h3>
            <p class="mc-pitch-desc" data-zh={p.descZh}>{p.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════ WALLPAPERS ═══════════════ -->
    <section class="mc-section mc-section-noise">
      <header class="mc-section-head">
        <h2 class="mc-h2" data-i18n-mc="wall-h">WALLPAPERS</h2>
        <p class="mc-section-sub" data-i18n-mc="wall-sub">Curated desktop scenes from the server.</p>
      </header>
      <div class="mc-wall-grid">
        {MINECRAFT.wallpapers.map(w => (
          <div class="mc-wall">
            <img src={w.thumb} alt={w.title} loading="lazy" decoding="async" width="640" height="360"/>
            <div class="mc-wall-info">
              <span class="mc-wall-title" data-zh={w.titleZh}>{w.title}</span>
              <a href={w.full} download class="mc-wall-dl">
                <span>{w.res}</span>
                <span>⬇</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════ FILES ═══════════════ -->
    <section class="mc-section mc-section-stone" style={`background-image: linear-gradient(rgba(29,31,36,.92), rgba(29,31,36,.92)), url('${MINECRAFT.sceneCherry}')`}>
      <header class="mc-section-head">
        <h2 class="mc-h2" data-i18n-mc="files-h">RESOURCES</h2>
        <p class="mc-section-sub" data-i18n-mc="files-sub">Mod packs, textures, and config files.</p>
      </header>

      <div class="mc-files">
        {MINECRAFT.files.map(f => (
          <div class="mc-file-card">
            <div class="mc-file-icon">{f.icon}</div>
            <div class="mc-file-body">
              <h3 class="mc-file-title" data-zh={f.titleZh}>{f.title}</h3>
              <p class="mc-file-desc" data-zh={f.descZh}>{f.desc}</p>
              <div class="mc-file-tags">
                <span class="mc-tag">{f.provider}</span>
                <span class="mc-tag mc-tag-size">{f.size}</span>
                {f.code && <span class="mc-tag mc-tag-code" data-i18n-mc-prefix="code-prefix">code: {f.code}</span>}
              </div>
            </div>
            <a href={f.url} target="_blank" rel="noopener" class="mc-btn mc-btn-green mc-file-btn">
              <span class="mc-btn-icon">⬇</span>
              <span data-i18n-mc="download">GET</span>
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════ DOCS ═══════════════ -->
    <section class="mc-section mc-section-rain" style={`background-image: linear-gradient(rgba(29,31,36,.94), rgba(29,31,36,.94)), url('${MINECRAFT.sceneRain}')`}>
      <header class="mc-section-head">
        <h2 class="mc-h2" data-i18n-mc="docs-h">GUIDES</h2>
        <p class="mc-section-sub" data-i18n-mc="docs-sub">Setup walkthroughs and FAQs.</p>
      </header>

      <div class="mc-docs">
        {MINECRAFT.docs.map(d => (
          <a href={d.url} class="mc-doc">
            <span class="mc-doc-icon">{d.icon}</span>
            <span class="mc-doc-title" data-zh={d.titleZh}>{d.title}</span>
            <span class="mc-doc-arrow">→</span>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  // ── i18n ──
  const I18N: Record<string, Record<string,string>> = {
    en: {
      'join-label': 'JOIN OUR QQ GROUP',
      'copy': 'COPY',
      'explore': 'EXPLORE',
      'qr-fallback': 'put qq-group-qr.png in /public/minecraft/',
      'scan': 'SCAN TO JOIN',
      'gallery-h': 'SCREENSHOTS',
      'gallery-sub': 'Moments from our world.',
      'wall-h': 'WALLPAPERS',
      'wall-sub': 'Curated desktop scenes from the server.',
      'files-h': 'RESOURCES',
      'files-sub': 'Mod packs, textures, and config files.',
      'docs-h': 'GUIDES',
      'docs-sub': 'Setup walkthroughs and FAQs.',
      'download': 'GET',
    },
    zh: {
      'join-label': '加入 QQ 群',
      'copy': '复制',
      'explore': '探索',
      'qr-fallback': '把 qq-group-qr.png 放到 /public/minecraft/',
      'scan': '扫码加入',
      'gallery-h': '群友截图',
      'gallery-sub': '来自我们世界的瞬间。',
      'wall-h': '壁纸下载',
      'wall-sub': '精选的服务器场景桌面壁纸。',
      'files-h': '资源下载',
      'files-sub': '整合包、材质、配置文件。',
      'docs-h': '操作文档',
      'docs-sub': '部署教程与常见问题。',
      'download': '下载',
    },
  };
  function syncMc() {
    const lang = localStorage.getItem('lang') || 'en';
    const m = I18N[lang];
    document.querySelectorAll('[data-i18n-mc]').forEach(el => {
      const k = el.getAttribute('data-i18n-mc')!;
      if (m[k]) el.textContent = m[k];
    });
    // Tagline
    const tagline = document.getElementById('mc-tagline');
    if (tagline) tagline.textContent = lang === 'zh'
      ? 'A Minecraft community for builders.'.replace(/.*/,'一个属于建造者的 Minecraft 社群。')
      : 'A Minecraft community for builders.';
    // data-zh swap for file titles / docs
    document.querySelectorAll('[data-zh]').forEach(el => {
      const en = (el as HTMLElement).dataset.en || el.textContent || '';
      if (!(el as HTMLElement).dataset.en) (el as HTMLElement).dataset.en = el.textContent || '';
      el.textContent = lang === 'zh' ? (el as HTMLElement).dataset.zh || en : (el as HTMLElement).dataset.en || '';
    });
  }
  syncMc();
  document.getElementById('lang-btn')?.addEventListener('click', () => setTimeout(syncMc, 0));

  // ── Copy QQ group number ──
  const copyBtn = document.getElementById('copy-qq-btn');
  copyBtn?.addEventListener('click', async () => {
    const groupNo = document.querySelector('.mc-group-no')?.textContent ?? '';
    try {
      await navigator.clipboard.writeText(groupNo.trim());
      const label = copyBtn.querySelector('span:last-child') as HTMLElement;
      const original = label.textContent;
      label.textContent = (localStorage.getItem('lang') || 'en') === 'zh' ? '已复制' : 'COPIED';
      setTimeout(() => { if (label) label.textContent = original; }, 1400);
    } catch {}
  });
</script>

<!-- Live server status (uses public mcsrvstat.us API; runs only on this page) -->
<script is:inline define:vars={{ serverAddress: MINECRAFT.serverAddress }}>
  (function () {
    if (!serverAddress || serverAddress === 'EXAMPLE') return;
    function update() {
      var el = document.querySelector('[data-mc-online]');
      if (!el) return;
      fetch('https://api.mcsrvstat.us/3/' + encodeURIComponent(serverAddress), { cache: 'no-store' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && data.online) {
            var cur = (data.players && data.players.online) || 0;
            var max = (data.players && data.players.max) || 0;
            el.textContent = max > 0 ? (cur + '/' + max) : String(cur);
            el.style.color = '';
          } else {
            el.textContent = 'Offline';
            el.style.color = '#ff7a98';
          }
        })
        .catch(function () { /* keep last value */ });
    }
    update();
    setInterval(update, 60000);
    document.addEventListener('astro:after-swap', update);
  })();
</script>

<style>
  /* ════════════════════════════════════════════════════
     Minecraft community page — launcher-inspired
     ════════════════════════════════════════════════════ */
  @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

  .mc-root {
    --mc-bg:        #1d1f24;
    --mc-bg-2:      #252830;
    --mc-bg-3:      #2c2f38;
    --mc-stone:     #3a3e48;
    --mc-stone-lt:  #5a5f6c;
    --mc-line:      #14161a;
    --mc-text:      #e6e7ea;
    --mc-text-dim:  #9aa0ab;
    --mc-accent:    #4eaf52;          /* Minecraft grass green */
    --mc-accent-2:  #6cd070;
    --mc-gold:      #ffaa00;
    --mc-blue:      #58a6ff;
    --mc-pix:       'Press Start 2P', 'Minecraft', monospace;
    --mc-sans:      'Inter', system-ui, sans-serif;

    background: var(--mc-bg);
    color: var(--mc-text);
    font-family: var(--mc-sans);
    margin-top: -92px;
    min-height: 100vh;
  }

  /* ── Hero ── */
  .mc-hero {
    position: relative;
    padding: 8rem 1.5rem 4rem;
    overflow: hidden;
    border-bottom: 4px solid var(--mc-line);
  }
  .mc-hero-bg {
    position: absolute; inset: -5%;
    background-size: cover; background-position: center;
    filter: brightness(.72) saturate(1.1) contrast(1.08);   /* less dim, more vibrant */
    transform: translateZ(0);
    will-change: transform;
    animation: mcHeroZoom 28s ease-in-out infinite alternate;
  }
  @keyframes mcHeroZoom {
    from { transform: scale(1.02); }
    to   { transform: scale(1.12); }
  }
  .mc-hero-overlay {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(29,31,36,0) 0%, rgba(29,31,36,.85) 90%, var(--mc-bg) 100%),
      linear-gradient(90deg, rgba(29,31,36,.55) 0%, rgba(29,31,36,.15) 100%);
  }
  .mc-hero-inner {
    position: relative; z-index: 1;
    max-width: 68rem; margin: 0 auto;
  }

  /* ── Floating decorative blocks ── */
  .mc-float-blocks {
    position: absolute; inset: 0;
    pointer-events: none; z-index: 1;
  }
  .mc-fb {
    position: absolute;
    font-size: 2.5rem;
    opacity: .35;
    filter: drop-shadow(0 4px 10px rgba(0,0,0,.5));
    animation: mcFloat 8s ease-in-out infinite;
  }
  .mc-fb-1 { top: 18%; right: 10%; animation-delay: 0s;   font-size: 2.75rem; }
  .mc-fb-2 { top: 35%; right: 6%;  animation-delay: 1.5s; font-size: 2rem; }
  .mc-fb-3 { top: 60%; right: 18%; animation-delay: 3s;   font-size: 2.25rem; }
  .mc-fb-4 { top: 75%; right: 8%;  animation-delay: 1s;   font-size: 1.75rem; }
  .mc-fb-5 { top: 25%; right: 22%; animation-delay: 2.5s; font-size: 2.25rem; }
  @keyframes mcFloat {
    0%,100% { transform: translateY(0) rotate(-3deg); }
    50%     { transform: translateY(-15px) rotate(3deg); }
  }
  @media (max-width: 768px) { .mc-float-blocks { display: none; } }

  /* ── Live status dot ── */
  .mc-status-dot {
    width: 6px; height: 6px;
    background: #30d158;
    border-radius: 50%;
    box-shadow: 0 0 8px #30d158;
    animation: mcPulse 1.6s ease-in-out infinite;
  }
  @keyframes mcPulse {
    0%,100% { opacity: 1; transform: scale(1); }
    50%     { opacity: .5; transform: scale(.85); }
  }

  /* ── Feature tags row ── */
  .mc-feat-tags {
    display: flex; flex-wrap: wrap; gap: .4rem;
    margin: 1.5rem 0 2rem;
    max-width: 38rem;
  }
  .mc-feat-tag {
    font-family: var(--mc-pix);
    font-size: .55rem;
    padding: .4rem .65rem;
    background: rgba(78,175,82,.15);
    color: var(--mc-accent-2);
    border: 1px solid rgba(78,175,82,.4);
    letter-spacing: .12em;
    -webkit-font-smoothing: none;
    text-shadow: 1px 1px 0 #000;
  }
  /* Cycle accent colors across tags for variety */
  .mc-feat-tag:nth-child(2) { background: rgba(88,166,255,.15); color: var(--mc-blue); border-color: rgba(88,166,255,.4); }
  .mc-feat-tag:nth-child(3) { background: rgba(255,170,0,.15);  color: var(--mc-gold); border-color: rgba(255,170,0,.4); }
  .mc-feat-tag:nth-child(4) { background: rgba(191,90,242,.15); color: #d896ff;       border-color: rgba(191,90,242,.4); }
  .mc-feat-tag:nth-child(5) { background: rgba(255,55,95,.15);  color: #ff7a98;       border-color: rgba(255,55,95,.4); }

  /* ── Highlights / stat strip ── */
  .mc-highlights {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 0;
    margin-bottom: 2.5rem;
    padding: 1rem 1.25rem;
    background: rgba(0,0,0,.45);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,.1);
    width: fit-content;
    border-radius: 4px;
    box-shadow: inset 1px 1px 0 rgba(255,255,255,.05), 0 8px 24px rgba(0,0,0,.4);
  }
  .mc-hl {
    display: flex; flex-direction: column;
    padding: 0 1.5rem;
    border-right: 1px solid rgba(255,255,255,.1);
  }
  .mc-hl:last-child { border-right: none; }
  .mc-hl-value {
    font-family: var(--mc-pix);
    font-size: 1.125rem;
    color: var(--mc-gold);
    letter-spacing: .02em;
    text-shadow: 2px 2px 0 #000;
    -webkit-font-smoothing: none;
    line-height: 1.1;
  }
  .mc-hl-label {
    font-family: var(--mc-pix);
    font-size: .5rem;
    color: var(--mc-text-dim);
    letter-spacing: .15em;
    margin-top: .35rem;
    -webkit-font-smoothing: none;
  }
  @media (max-width: 640px) {
    /* 2×2 grid so the longest value (1.21.x) has room to breathe */
    .mc-highlights {
      grid-template-columns: 1fr 1fr;
      gap: 0;
      width: 100%;
      padding: 0;
    }
    .mc-hl {
      padding: .85rem 1rem;
      border-right: 1px solid rgba(255,255,255,.08);
      border-bottom: 1px solid rgba(255,255,255,.08);
      align-items: flex-start;
    }
    .mc-hl:nth-child(2) { border-right: none; }
    .mc-hl:nth-child(3),
    .mc-hl:nth-child(4) { border-bottom: none; }
    .mc-hl:nth-child(4) { border-right: none; }
    .mc-hl-value { font-size: 1.05rem; }
    .mc-hl-label { font-size: .48rem; margin-top: .25rem; }
  }

  /* ── Pitch section — "what we're about" ── */
  .mc-pitch-section {
    padding: 4rem 1.5rem;
    background:
      linear-gradient(180deg, var(--mc-bg) 0%, var(--mc-bg-2) 100%);
    border-bottom: 4px solid var(--mc-line);
  }
  .mc-pitch-grid {
    max-width: 68rem; margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 768px) {
    .mc-pitch-grid { grid-template-columns: 1fr; }
    .mc-pitch-section { padding: 3rem 1rem; }
  }
  .mc-pitch-card {
    background: var(--mc-bg-3);
    border: 1px solid var(--mc-stone-lt);
    padding: 2rem 1.5rem;
    text-align: center;
    box-shadow:
      inset 2px 2px 0 var(--mc-stone),
      inset -2px -2px 0 var(--mc-line),
      6px 6px 0 rgba(0,0,0,.4);
    transition: transform .2s, border-color .2s;
    position: relative;
  }
  .mc-pitch-card:hover {
    transform: translate(-2px,-3px);
    border-color: var(--mc-accent);
    box-shadow:
      inset 2px 2px 0 var(--mc-stone),
      inset -2px -2px 0 var(--mc-line),
      8px 8px 0 rgba(0,0,0,.5),
      0 0 0 1px rgba(78,175,82,.2);
  }
  .mc-pitch-card:nth-child(1) { border-top: 3px solid var(--mc-accent); }
  .mc-pitch-card:nth-child(2) { border-top: 3px solid var(--mc-blue); }
  .mc-pitch-card:nth-child(3) { border-top: 3px solid var(--mc-gold); }
  .mc-pitch-icon {
    font-size: 2.75rem;
    margin-bottom: 1rem;
    line-height: 1;
    filter: drop-shadow(0 4px 8px rgba(0,0,0,.4));
  }
  .mc-pitch-title {
    font-family: var(--mc-pix);
    font-size: .8rem;
    color: var(--mc-text);
    letter-spacing: .1em;
    margin-bottom: .75rem;
    text-shadow: 2px 2px 0 #000;
    -webkit-font-smoothing: none;
  }
  .mc-pitch-desc {
    font-size: .875rem;
    color: var(--mc-text-dim);
    line-height: 1.65;
  }

  /* ── Pixel tag (top badge) ── */
  .mc-pix-tag {
    display: inline-flex; align-items: center; gap: .55rem;
    padding: .45rem .75rem;
    background: rgba(0,0,0,.4);
    border: 1px solid var(--mc-stone-lt);
    color: var(--mc-text-dim);
    font-family: var(--mc-pix);
    font-size: .55rem;
    letter-spacing: .15em;
    margin-bottom: 1.5rem;
  }
  .mc-block-square {
    width: 8px; height: 8px;
    background: var(--mc-accent);
    box-shadow: inset 1px 1px 0 var(--mc-accent-2), inset -1px -1px 0 #2a662a;
  }

  /* ── Title (no overlap; single text + pixel-style stroke shadow) ── */
  .mc-title {
    font-family: var(--mc-pix);
    font-size: clamp(1.75rem, 4.5vw, 3rem);
    line-height: 1.1;
    margin: 0 0 .75rem;
    color: var(--mc-text);
    letter-spacing: .04em;
    /* Pixel-art "8-bit" shadow: 4 solid offsets, no anti-alias */
    text-shadow:
      4px 4px 0 #000,
      0 4px 0 #000,
      4px 0 0 #000;
    -webkit-font-smoothing: none;
  }
  .mc-tagline {
    font-size: 1rem;
    color: var(--mc-text-dim);
    line-height: 1.65;
    max-width: 32rem;
    margin: 0 0 2.5rem;
  }

  /* ── Join card ── */
  .mc-join {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    align-items: center;
    background: rgba(20,22,26,.75);
    backdrop-filter: blur(8px);
    border: 1px solid var(--mc-stone-lt);
    border-radius: 4px;
    padding: 1.75rem;
    max-width: 36rem;
    box-shadow:
      inset 2px 2px 0 var(--mc-stone),
      inset -2px -2px 0 var(--mc-line),

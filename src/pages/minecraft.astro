---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MINECRAFT } from '../config/site';
---
<BaseLayout title={`${MINECRAFT.name} — Minecraft Utility`}>

  <!-- 整个 Minecraft 板块包在这个根容器里，所有像素风样式只作用在内部 -->
  <div class="mc-root">

    <!-- ─── Hero ─── -->
    <section class="mc-hero">
      <div class="mc-hero-sky"></div>
      <div class="mc-hero-clouds"></div>
      <div class="mc-hero-ground"></div>

      <div class="mc-hero-inner">
        <div class="mc-badge">
          <span class="mc-pix-heart"></span>
          <span>BETA · {MINECRAFT.mcVersion}</span>
        </div>

        <h1 class="mc-title">
          <span class="mc-title-shadow">{MINECRAFT.name}</span>
          <span class="mc-title-front">{MINECRAFT.name}</span>
        </h1>
        <p class="mc-tagline" id="mc-tagline">{MINECRAFT.tagline}</p>

        <div class="mc-cta-row">
          <a href={MINECRAFT.downloadUrl} class="mc-btn mc-btn-primary">
            <span class="mc-btn-icon">⬇</span>
            <span data-i18n-custom="mc-download">Download {MINECRAFT.version}</span>
          </a>
          <a href="#features" class="mc-btn mc-btn-secondary">
            <span class="mc-btn-icon">✦</span>
            <span data-i18n-custom="mc-features">Features</span>
          </a>
        </div>

        <!-- 像素风工具栏 (hotbar) -->
        <div class="mc-hotbar">
          <div class="mc-slot active"><span>⚔</span></div>
          <div class="mc-slot"><span>🧭</span></div>
          <div class="mc-slot"><span>👁</span></div>
          <div class="mc-slot"><span>🎯</span></div>
          <div class="mc-slot"><span>🌍</span></div>
          <div class="mc-slot"><span>💎</span></div>
          <div class="mc-slot"><span>🛡</span></div>
          <div class="mc-slot"><span>✨</span></div>
        </div>
      </div>
    </section>

    <!-- ─── Stats bar ─── -->
    <section class="mc-stats">
      {MINECRAFT.stats.map(s => (
        <div class="mc-stat">
          <span class="mc-stat-value">{s.value}</span>
          <span class="mc-stat-label">{s.label}</span>
        </div>
      ))}
    </section>

    <!-- ─── Features ─── -->
    <section id="features" class="mc-section">
      <h2 class="mc-section-title">
        <span class="mc-section-title-shadow">FEATURES</span>
        <span class="mc-section-title-front" data-i18n-custom="mc-features-title">FEATURES</span>
      </h2>
      <p class="mc-section-sub" data-i18n-custom="mc-features-sub">
        Over 80 modules across 6 categories. Fully configurable.
      </p>

      <div class="mc-feature-grid">
        {MINECRAFT.features.map(f => (
          <div class="mc-feature-card">
            <div class="mc-feature-icon">{f.icon}</div>
            <h3 class="mc-feature-title">{f.title}</h3>
            <p class="mc-feature-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ─── Install ─── -->
    <section class="mc-section">
      <h2 class="mc-section-title">
        <span class="mc-section-title-shadow">INSTALL</span>
        <span class="mc-section-title-front" data-i18n-custom="mc-install-title">INSTALL</span>
      </h2>
      <div class="mc-install-grid">
        <div class="mc-step">
          <div class="mc-step-num">1</div>
          <p class="mc-step-text" data-i18n-custom="mc-step-1">Download the latest release.</p>
        </div>
        <div class="mc-step">
          <div class="mc-step-num">2</div>
          <p class="mc-step-text" data-i18n-custom="mc-step-2">Drop the jar into <code>.minecraft/mods</code>.</p>
        </div>
        <div class="mc-step">
          <div class="mc-step-num">3</div>
          <p class="mc-step-text" data-i18n-custom="mc-step-3">Launch with Fabric loader and press <kbd>RShift</kbd>.</p>
        </div>
      </div>
    </section>

    <!-- ─── Footer disclaimer ─── -->
    <section class="mc-disclaimer">
      <p data-i18n-custom="mc-disclaimer">
        ⚠ For educational use only. Respect server rules.
      </p>
    </section>

  </div>
</BaseLayout>

<script>
  const I18N: Record<string, Record<string,string>> = {
    en: {
      'mc-download': 'Download v2.7.4',
      'mc-features': 'Features',
      'mc-features-title': 'FEATURES',
      'mc-features-sub': 'Over 80 modules across 6 categories. Fully configurable.',
      'mc-install-title': 'INSTALL',
      'mc-step-1': 'Download the latest release.',
      'mc-step-2': 'Drop the jar into .minecraft/mods.',
      'mc-step-3': 'Launch with Fabric loader and press RShift to open menu.',
      'mc-disclaimer': '⚠ For educational use only. Respect server rules.',
    },
    zh: {
      'mc-download': '下载 v2.7.4',
      'mc-features': '功能',
      'mc-features-title': '模块功能',
      'mc-features-sub': '6 大类，80+ 个模块，完全可配置。',
      'mc-install-title': '安装步骤',
      'mc-step-1': '下载最新版本。',
      'mc-step-2': '把 jar 文件丢进 .minecraft/mods 目录。',
      'mc-step-3': '用 Fabric loader 启动，按 RShift 打开菜单。',
      'mc-disclaimer': '⚠ 仅供学习交流使用，请尊重服务器规则。',
    },
  };
  function syncMc() {
    const lang = localStorage.getItem('lang') || 'en';
    const m = I18N[lang];
    document.querySelectorAll('[data-i18n-custom]').forEach(el => {
      const k = el.getAttribute('data-i18n-custom')!;
      if (m[k]) el.textContent = m[k];
    });
    const tagline = document.getElementById('mc-tagline');
    if (tagline) {
      tagline.textContent = lang === 'zh'
        ? '高端的 Minecraft 辅助客户端'
        : 'A premium Minecraft utility client';
    }
  }
  syncMc();
  document.getElementById('lang-btn')?.addEventListener('click', () => setTimeout(syncMc, 0));
</script>

<style>
  /* ╔══════════════════════════════════════════════
     Minecraft section — pixel-perfect, blocky, classic Minecraft UI
     ──────────────────────────────────────────────
     All styles scoped under .mc-root so they don't
     leak into the rest of the Apple-style site.
     ══════════════════════════════════════════════ */
  @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

  .mc-root {
    --mc-grass-top:   #5fb04a;
    --mc-grass-side:  #8b6f47;
    --mc-dirt:        #6b4423;
    --mc-stone:       #6e6e6e;
    --mc-stone-dark:  #4a4a4a;
    --mc-wood:        #835c33;
    --mc-sky:         #67bdf6;
    --mc-cloud:       #ffffff;
    --mc-gold:        #ffd700;
    --mc-diamond:     #4cdde0;
    --mc-redstone:    #ed3030;
    --mc-emerald:     #1ddc6c;
    --mc-text:        #ffffff;
    --mc-text-shadow: #3f3f3f;
    font-family: 'Press Start 2P', 'Minecraft', monospace;
    color: var(--mc-text);
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;

    /* Override the Apple page padding from BaseLayout */
    margin-top: -92px;
  }
  /* Sharp pixel-style text — kill anti-alias smoothing */
  .mc-root * {
    -webkit-font-smoothing: none;
    text-rendering: optimizeSpeed;
  }

  /* ╔══════ Hero ══════╗ */
  .mc-hero {
    position: relative;
    min-height: 90vh;
    overflow: hidden;
    padding: 12rem 1.5rem 6rem;
    background:
      linear-gradient(180deg, #4ba7e0 0%, #6cc1ec 60%, #87ceeb 100%);
  }

  /* Pixelated clouds — pure CSS, no image */
  .mc-hero-clouds {
    position: absolute; inset: 0;
    background-image:
      /* big cloud */
      linear-gradient(90deg, transparent 5%, #fff 5%, #fff 18%, transparent 18%),
      linear-gradient(90deg, transparent 8%, #fff 8%, #fff 22%, transparent 22%),
      /* smaller cloud */
      linear-gradient(90deg, transparent 65%, #fff 65%, #fff 78%, transparent 78%);
    background-size: 100% 12px, 100% 12px, 100% 14px;
    background-position: 0 60px, 0 72px, 0 130px;
    background-repeat: no-repeat;
    opacity: .9;
    animation: mcCloudDrift 60s linear infinite;
  }
  @keyframes mcCloudDrift {
    from { background-position: 0 60px, 0 72px, 0 130px; }
    to   { background-position: 100% 60px, 100% 72px, 100% 130px; }
  }

  /* Pixelated ground at bottom */
  .mc-hero-ground {
    position: absolute; left: 0; right: 0; bottom: 0;
    height: 120px;
    background:
      /* grass top stripe */
      linear-gradient(180deg, var(--mc-grass-top) 0 16px, transparent 16px),
      /* dirt rows with grain */
      repeating-linear-gradient(90deg,
        var(--mc-dirt) 0 16px,
        #5a3a1d 16px 18px,
        var(--mc-dirt) 18px 32px,
        #7a4d28 32px 34px),
      var(--mc-dirt);
    box-shadow: inset 0 16px 0 rgba(0,0,0,.15);
  }

  .mc-hero-inner {
    position: relative; z-index: 2;
    max-width: 56rem; margin: 0 auto;
    text-align: center;
  }

  /* ── Beta badge ── */
  .mc-badge {
    display: inline-flex; align-items: center; gap: .5rem;
    background: var(--mc-stone-dark);
    color: #fff;
    padding: .55rem .85rem;
    font-size: .55rem;
    letter-spacing: .1em;
    margin-bottom: 1.5rem;
    border: 2px solid #000;
    box-shadow:
      inset 2px 2px 0 #888,
      inset -2px -2px 0 #2a2a2a,
      4px 4px 0 rgba(0,0,0,.4);
  }
  .mc-pix-heart {
    width: 10px; height: 10px;
    background: var(--mc-redstone);
    box-shadow:
      -3px 0 0 var(--mc-redstone),
      3px 0 0 var(--mc-redstone),
      0 3px 0 var(--mc-redstone),
      -3px 3px 0 var(--mc-redstone),
      3px 3px 0 var(--mc-redstone),
      0 -3px 0 var(--mc-redstone),
      6px -3px 0 var(--mc-redstone),
      -6px -3px 0 var(--mc-redstone),
      -3px -3px 0 var(--mc-redstone),
      3px -3px 0 var(--mc-redstone),
      0 -6px 0 var(--mc-redstone),
      0 6px 0 var(--mc-redstone),
      3px 6px 0 var(--mc-redstone),
      -3px 6px 0 var(--mc-redstone);
    display: inline-block;
    animation: mcHeartBeat 1s ease-in-out infinite;
  }
  @keyframes mcHeartBeat { 0%,100%{transform:scale(1)} 50%{transform:scale(1.15)} }

  /* ── Title with classic Minecraft double-layer shadow ── */
  .mc-title {
    position: relative;
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 1;
    margin: 0 0 1.5rem;
    color: var(--mc-text);
    letter-spacing: .02em;
    transform: rotate(-2deg);
  }
  .mc-title-shadow, .mc-title-front {
    display: inline-block;
  }
  .mc-title-shadow {
    position: absolute; top: 4px; left: 4px;
    color: #2a2a2a;
    z-index: 1;
  }
  .mc-title-front {
    position: relative;
    background: linear-gradient(180deg, #ffe16a 0%, #ffb700 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    z-index: 2;
    text-shadow: 0 4px 0 #b27d00;
  }

  .mc-tagline {
    font-size: .65rem;
    color: #fff;
    text-shadow: 2px 2px 0 var(--mc-text-shadow);
    margin-bottom: 2.5rem;
    line-height: 1.6;
    letter-spacing: .05em;
  }

  /* ── Minecraft buttons (classic stone-button look) ── */
  .mc-cta-row {
    display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;
    margin-bottom: 3rem;
  }
  .mc-btn {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .85rem 1.5rem;
    font-family: inherit;
    font-size: .65rem;
    letter-spacing: .05em;
    text-decoration: none;
    color: #fff;
    background: var(--mc-stone);
    border: 2px solid #000;
    box-shadow:
      inset 2px 2px 0 #989898,
      inset -2px -2px 0 #4f4f4f,
      4px 4px 0 rgba(0,0,0,.5);
    text-shadow: 2px 2px 0 var(--mc-text-shadow);
    transition: transform .08s ease, box-shadow .08s ease;
    cursor: pointer;
  }
  .mc-btn:hover {
    background: #7e7e7e;
    box-shadow:
      inset 2px 2px 0 #aaa,
      inset -2px -2px 0 #5a5a5a,
      4px 4px 0 rgba(0,0,0,.5);
  }
  .mc-btn:active {
    transform: translate(2px,2px);
    box-shadow:
      inset 2px 2px 0 #989898,
      inset -2px -2px 0 #4f4f4f,
      2px 2px 0 rgba(0,0,0,.5);
  }
  .mc-btn-primary {
    background: #4ea84e;
    box-shadow:
      inset 2px 2px 0 #7ed87e,
      inset -2px -2px 0 #2a662a,
      4px 4px 0 rgba(0,0,0,.5);
  }
  .mc-btn-primary:hover {
    background: #5fb85f;
    box-shadow:
      inset 2px 2px 0 #92ee92,
      inset -2px -2px 0 #357335,
      4px 4px 0 rgba(0,0,0,.5);
  }
  .mc-btn-icon { font-size: .8rem; }

  /* ── Hotbar (像素工具栏) ── */
  .mc-hotbar {
    display: inline-flex; gap: 0;
    padding: 4px;
    background: rgba(0,0,0,.5);
    border: 2px solid #000;
    box-shadow:
      inset 2px 2px 0 #555,
      inset -2px -2px 0 #1a1a1a,
      4px 4px 0 rgba(0,0,0,.4);
  }
  .mc-slot {
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    background: var(--mc-stone-dark);
    border: 2px solid #000;
    box-shadow:
      inset 2px 2px 0 #383838,
      inset -2px -2px 0 #1f1f1f;
    margin: 0 -1px;
    font-size: 1.5rem;
    transition: transform .15s ease;
  }
  .mc-slot.active {
    border-color: #fff;
    transform: translateY(-4px);
    box-shadow:
      inset 2px 2px 0 #555,
      inset -2px -2px 0 #2a2a2a,
      0 0 0 2px rgba(255,255,255,.6);
  }

  /* ╔══════ Stats ══════╗ */
  .mc-stats {
    background: var(--mc-stone-dark);
    border-top: 6px solid #000;
    border-bottom: 6px solid #000;
    padding: 2rem 1.5rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    text-align: center;
  }
  .mc-stat { display: flex; flex-direction: column; gap: .35rem; }
  .mc-stat-value {
    font-size: 1.5rem;
    color: var(--mc-gold);
    text-shadow: 2px 2px 0 #6b4d00, 3px 3px 0 #000;
  }
  .mc-stat-label {
    font-size: .55rem;
    color: #ccc;
    letter-spacing: .15em;
  }

  /* ╔══════ Section ══════╗ */
  .mc-section {
    background: var(--mc-stone);
    background-image:
      repeating-linear-gradient(0deg,
        rgba(0,0,0,.08) 0 16px,
        rgba(255,255,255,.04) 16px 32px),
      repeating-linear-gradient(90deg,
        rgba(0,0,0,.08) 0 16px,
        rgba(255,255,255,.04) 16px 32px);
    padding: 4rem 1.5rem;
    text-align: center;
    border-bottom: 6px solid #000;
  }

  .mc-section-title {
    position: relative;
    display: inline-block;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    margin-bottom: .75rem;
    letter-spacing: .08em;
  }
  .mc-section-title-shadow {
    position: absolute; top: 4px; left: 4px;
    color: #000; z-index: 1;
  }
  .mc-section-title-front {
    position: relative; z-index: 2;
    background: linear-gradient(180deg, var(--mc-diamond) 0%, #1f9095 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 4px 0 #003536;
  }
  .mc-section-sub {
    font-size: .6rem;
    color: #ddd;
    text-shadow: 2px 2px 0 #000;
    line-height: 1.7;
    max-width: 32rem;
    margin: 0 auto 3rem;
  }

  /* ╔══════ Feature cards (boîtes en pierre) ══════╗ */
  .mc-feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.25rem;
    max-width: 60rem; margin: 0 auto;
  }
  .mc-feature-card {
    background: var(--mc-stone-dark);
    border: 3px solid #000;
    padding: 1.5rem 1.25rem;
    text-align: center;
    box-shadow:
      inset 3px 3px 0 #5a5a5a,
      inset -3px -3px 0 #2a2a2a,
      6px 6px 0 rgba(0,0,0,.5);
    transition: transform .15s ease;
    position: relative;
  }
  .mc-feature-card:hover {
    transform: translate(-2px,-2px);
    box-shadow:
      inset 3px 3px 0 #6a6a6a,
      inset -3px -3px 0 #2a2a2a,
      8px 8px 0 rgba(0,0,0,.5);
  }
  .mc-feature-icon {
    font-size: 2rem;
    margin-bottom: .85rem;
    line-height: 1;
  }
  .mc-feature-title {
    font-size: .85rem;
    color: var(--mc-gold);
    text-shadow: 2px 2px 0 #6b4d00, 3px 3px 0 #000;
    margin-bottom: .5rem;
    letter-spacing: .08em;
  }
  .mc-feature-desc {
    font-size: .55rem;
    color: #d8d8d8;
    line-height: 1.7;
    text-shadow: 1px 1px 0 #000;
  }

  /* ╔══════ Install steps ══════╗ */
  .mc-install-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px,1fr));
    gap: 1.25rem;
    max-width: 60rem; margin: 0 auto;
  }
  .mc-step {
    background: var(--mc-wood);
    background-image:
      repeating-linear-gradient(0deg,
        rgba(0,0,0,.1) 0 6px,
        transparent 6px 12px);
    border: 3px solid #000;
    padding: 1.5rem 1.25rem;
    text-align: left;
    display: flex; gap: .75rem; align-items: flex-start;
    box-shadow:
      inset 3px 3px 0 #a37a4d,
      inset -3px -3px 0 #5d3e1f,
      6px 6px 0 rgba(0,0,0,.5);
  }
  .mc-step-num {
    width: 32px; height: 32px;
    background: var(--mc-gold);
    color: #000;
    display: flex; align-items: center; justify-content: center;
    font-size: .85rem;
    border: 2px solid #000;
    box-shadow: inset 2px 2px 0 #fff09a, inset -2px -2px 0 #c2a300;
    flex-shrink: 0;
  }
  .mc-step-text {
    font-size: .6rem;
    line-height: 1.75;
    color: #fff;
    text-shadow: 2px 2px 0 #000;
  }
  .mc-step-text code, .mc-step-text kbd {
    background: #000; color: var(--mc-gold);
    padding: 1px 6px;
    border: 1px solid var(--mc-stone);
    font-family: inherit;
    font-size: .9em;
  }

  /* ╔══════ Disclaimer ══════╗ */
  .mc-disclaimer {
    background: #3a2222;
    padding: 1.5rem;
    text-align: center;
    border-top: 3px solid #000;
  }
  .mc-disclaimer p {
    font-size: .55rem;
    color: #ffba6e;
    letter-spacing: .08em;
    text-shadow: 1px 1px 0 #000;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .mc-stats { grid-template-columns: repeat(2,1fr); }
    .mc-slot { width: 36px; height: 36px; font-size: 1.2rem; }
    .mc-hotbar { transform: scale(.85); }
    .mc-title { transform: none; }
  }
</style>

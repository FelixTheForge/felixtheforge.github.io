---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const tagMap = new Map<string, number>();
posts.forEach(p => p.data.tags?.forEach(t => tagMap.set(t, (tagMap.get(t) ?? 0) + 1)));
const tags = [...tagMap.entries()].sort((a,b) => b[1]-a[1]);
---

<BaseLayout title="Tags — FelixTheForge">
  <PageBanner
    title="Tags"
    subtitle="Browse by topic."
    image="https://images.unsplash.com/photo-1476900543704-4312b429f7e3?w=1400&q=80"
    tint="rgba(20,15,10,.55)"
  />
  <div class="fade-in page-wrap">
    <h1 class="page-title">Tags</h1>
    <p class="page-sub">{tags.length} topics explored so far.</p>
    <div class="tags-cloud">
      {tags.map(([tag, count]) => (
        <a href={`/tags/${tag}`} class="cloud-tag">
          {tag}
          <span class="cloud-count">{count}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-wrap { max-width: 42rem; margin: 0 auto; padding: 4rem 0; }
  .page-title { font-family: var(--font-serif); font-size: 2.5rem; font-weight: 500; margin-bottom: .5rem; }
  .page-sub { font-family: var(--font-serif); font-style: italic; color: var(--color-muted); margin-bottom: 3rem; }
  .tags-cloud { display: flex; flex-wrap: wrap; gap: .75rem; }
  .cloud-tag {
    display: flex; align-items: center; gap: .4rem;
    font-family: var(--font-sans); font-size: .8rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--color-ink); text-decoration: none;
    border: 1px solid var(--color-border); padding: .5rem 1rem; border-radius: 2px;
    transition: border-color .2s, color .2s, background .2s;
  }
  .cloud-tag:hover { border-color: var(--color-accent); color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 5%, transparent); }
  .cloud-count {
    font-size: .65rem; color: var(--color-muted);
    background: var(--color-border); padding: .1rem .35rem; border-radius: 999px;
  }
</style>

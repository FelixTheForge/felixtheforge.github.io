---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FRIENDS, INSPIRATIONS, SITE } from '../config/site';
---
<BaseLayout title={`Friends — ${SITE.title}`}>

  <!-- Ambient orbs behind content (same trick as /blog) -->
  <div class="friends-ambient" aria-hidden="true">
    <span class="orb orb-1"></span>
    <span class="orb orb-2"></span>
  </div>

  <div class="page-wrap">

    <!-- ── Header ── -->
    <header class="friends-hero fade-up">
      <span class="friends-eyebrow" data-i18n-custom="friends-eyebrow">The web is a quiet party</span>
      <h1 class="friends-title">
        <span class="friends-title-grad" data-i18n="nav.friends">Friends</span>
      </h1>
      <p class="friends-intro" data-i18n-custom="friends-intro">
        A short list of people whose corners of the internet I keep coming back to.
        Not influencers, not networking — just folks worth knowing.
      </p>
    </header>

    <!-- ── Real friends ── -->
    <section class="fade-up" style="animation-delay:.1s">
      <div class="section-label">
        <span class="section-dot people"></span>
        <span class="section-text" data-i18n-custom="friends-people-label">People I know</span>
        <span class="section-count">{FRIENDS.length}</span>
      </div>

      <div class={`friends-grid ${FRIENDS.length <= 2 ? 'sparse' : ''}`}>
        {FRIENDS.map((f, i) => (
          <a href={f.url} target="_blank" rel="noopener noreferrer"
             class="friend-card"
             style={`--fc:${f.color}; animation-delay:${i*0.08}s`}>
            <div class="friend-glow"></div>

            <div class="friend-head">
              <img src={f.avatar} alt={f.name} class="friend-avatar" loading="lazy"
                   onerror="this.style.background='linear-gradient(135deg,var(--fc),#fff)';this.removeAttribute('src');"/>
              <div class="friend-id">
                <h3 class="friend-name">{f.name}</h3>
                <p class="friend-bio">{f.bio}</p>
                <span class="friend-url">{new URL(f.url).hostname.replace('www.','')}</span>
              </div>
              <svg class="friend-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M7 17L17 7M9 7h8v8"/>
              </svg>
            </div>

            {(f as any).tags && (
              <div class="friend-tags">
                {(f as any).tags.map((t: string) => <span class="friend-tag">{t}</span>)}
              </div>
            )}

            {(f as any).note && (
              <blockquote class="friend-note" data-zh={(f as any).note} data-en={(f as any).noteEn || ''}>
                <span class="friend-quote-mark">"</span>
                <span class="friend-note-text">{(f as any).noteEn || (f as any).note}</span>
              </blockquote>
            )}
          </a>
        ))}
      </div>
    </section>

    <!-- ── Inspirations (people / sites I don't personally know) ── -->
    {INSPIRATIONS && INSPIRATIONS.length > 0 && (
      <section class="fade-up" style="animation-delay:.2s">
        <div class="section-label">
          <span class="section-dot inspire"></span>
          <span class="section-text" data-i18n-custom="friends-inspire-label">Sites I keep coming back to</span>
          <span class="section-count">{INSPIRATIONS.length}</span>
        </div>

        <div class="inspire-list">
          {INSPIRATIONS.map(s => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="inspire-row">
              <img src={s.favicon} alt="" class="inspire-favicon" loading="lazy" onerror="this.style.display='none'"/>
              <div class="inspire-text">
                <span class="inspire-name">{s.name}</span>
                <span class="inspire-desc" data-zh={s.descZh}>{s.desc}</span>
              </div>
              <span class="inspire-host">{new URL(s.url).hostname.replace('www.','')}</span>
              <svg class="inspire-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M7 17L17 7M9 7h8v8"/>
              </svg>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ── Exchange links CTA ── -->
    <section class="fade-up" style="animation-delay:.3s">
      <div class="exchange-card">
        <div class="exchange-text">
          <h3 class="exchange-title" data-i18n-custom="friends-exchange-title">Want to exchange links?</h3>
          <p class="exchange-sub" data-i18n-custom="friends-exchange-sub">
            Drop me a note via GitHub or email. I read everything.
          </p>
        </div>
        <div class="exchange-actions">
          {SITE.social.github && (
            <a href={SITE.social.github} target="_blank" rel="noopener" class="exchange-btn primary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
              <span data-i18n-custom="friends-via-github">via GitHub</span>
            </a>
          )}
          <a href="/about" class="exchange-btn">
            <span data-i18n-custom="friends-more-about">More about me</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  const I18N_CUSTOM: Record<string, Record<string,string>> = {
    en: {
      'friends-eyebrow':         'The web is a quiet party',
      'friends-intro':           'A short list of people whose corners of the internet I keep coming back to. Not influencers, not networking — just folks worth knowing.',
      'friends-people-label':    'People I know',
      'friends-inspire-label':   'Sites I keep coming back to',
      'friends-exchange-title':  'Want to exchange links?',
      'friends-exchange-sub':    'Drop me a note via GitHub or email. I read everything.',
      'friends-via-github':      'via GitHub',
      'friends-more-about':      'More about me',
    },
    zh: {
      'friends-eyebrow':         '互联网是一场安静的派对',
      'friends-intro':           '一些我反复回访的、互联网角落里的人。不是网红，也不是社交关系 — 只是值得认识的人。',
      'friends-people-label':    '我认识的人',
      'friends-inspire-label':   '反复回访的站',
      'friends-exchange-title':  '想交换友链？',
      'friends-exchange-sub':    '通过 GitHub 或邮件给我留言，我会一一查看。',
      'friends-via-github':      '通过 GitHub',
      'friends-more-about':      '了解更多关于我',
    },
  };
  function syncFriends() {
    const lang = localStorage.getItem('lang') || 'en';
    const m = I18N_CUSTOM[lang];
    document.querySelectorAll('[data-i18n-custom]').forEach(el => {
      const k = el.getAttribute('data-i18n-custom')!;
      if (m[k]) el.textContent = m[k];
    });
    document.querySelectorAll('[data-zh]').forEach(el => {
      const h = el as HTMLElement;
      if (!h.dataset.en) h.dataset.en = h.textContent || '';
      h.textContent = lang === 'zh' ? (h.dataset.zh || '') : (h.dataset.en || '');
    });
  }
  syncFriends();
  document.getElementById('lang-btn')?.addEventListener('click', () => setTimeout(syncFriends, 0));
  document.addEventListener('astro:after-swap', syncFriends);
</script>

<style>
  /* ── Ambient orbs ── */
  .friends-ambient {
    position: absolute; inset: 0;
    pointer-events: none; z-index: 0;
    overflow: hidden;
  }
  .orb {
    position: absolute;
    width: 28vw; height: 28vw;
    border-radius: 50%;
    filter: blur(80px);
    opacity: .3;
  }
  .orb-1 { top: -10vw; right: -8vw;  background: radial-gradient(circle, rgba(139,92,246,.45), transparent 70%); }
  .orb-2 { bottom: -8vw; left: -5vw; background: radial-gradient(circle, rgba(0,113,227,.35), transparent 70%); }
  [data-theme="dark"] .orb { opacity: .5; }

  .page-wrap {
    position: relative; z-index: 1;
    max-width: 56rem; margin: 0 auto; padding: 4rem 1.5rem 6rem;
  }

  /* ── Hero ── */
  .friends-hero { margin-bottom: 3rem; }
  .friends-eyebrow {
    display: inline-block;
    font-size: .7rem; font-weight: 700;
    letter-spacing: .18em; text-transform: uppercase;
    color: var(--accent-4);
    padding: .25rem .65rem;
    background: rgba(139,92,246,.1);
    border: 1px solid rgba(139,92,246,.28);
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }
  .friends-title { margin: 0 0 1rem; line-height: 1.15; }
  .friends-title-grad {
    display: inline-block;
    font-size: clamp(3rem, 7vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -.04em;
    padding-bottom: .08em;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-4) 60%, #ec4899 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .friends-intro {
    font-size: 1rem; line-height: 1.7;
    color: var(--ink-3);
    max-width: 36rem;
  }

  /* ── Section label ── */
  .section-label {
    display: flex; align-items: center; gap: .65rem;
    margin: 2rem 0 1.5rem;
    padding-bottom: .85rem;
    border-bottom: 1px solid var(--border);
  }
  .section-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .section-dot.people  { background: var(--accent-4); box-shadow: 0 0 8px var(--accent-4); }
  .section-dot.inspire { background: var(--accent-5); }
  .section-text {
    font-size: .85rem; font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase;
    color: var(--ink-2);
  }
  .section-count {
    margin-left: auto;
    font-size: .7rem; font-weight: 600;
    color: var(--ink-4);
    padding: .15rem .5rem;
    background: var(--border);
    border-radius: 999px;
  }

  /* ── Friend cards ── */
  .friends-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: 1.25rem;
  }
  /* When only 1~2 friends, force max 2 columns and bigger cards */
  .friends-grid.sparse { grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); }

  .friend-card {
    position: relative;
    display: flex; flex-direction: column;
    gap: 1rem;
    padding: 1.5rem 1.5rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    box-shadow:
      0 1px 2px rgba(0,0,0,.04),
      0 4px 12px rgba(0,0,0,.05),
      inset 0 1px 0 rgba(255,255,255,.6);
    overflow: hidden;
    transition: transform .25s cubic-bezier(.25,.46,.45,.94),
                box-shadow .25s, border-color .25s;
    animation: fadeUp .6s cubic-bezier(.25,.46,.45,.94) both;
  }
  .friend-card::after {
    content: '';
    position: absolute; left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--fc);
    opacity: .9;
  }
  .friend-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--fc) 40%, transparent);
    box-shadow:
      0 6px 12px rgba(0,0,0,.06),
      0 20px 48px color-mix(in srgb, var(--fc) 22%, transparent),
      inset 0 1px 0 rgba(255,255,255,.7);
  }
  [data-theme="dark"] .friend-card {
    box-shadow:
      0 1px 2px rgba(0,0,0,.4),
      0 4px 12px rgba(0,0,0,.4),
      inset 0 1px 0 rgba(255,255,255,.04);
  }

  .friend-glow {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(120% 80% at 100% 0%,
                                color-mix(in srgb, var(--fc) 14%, transparent) 0%,
                                transparent 60%);
    opacity: 0; transition: opacity .3s;
  }
  .friend-card:hover .friend-glow { opacity: 1; }

  /* Head row */
  .friend-head { display: flex; align-items: center; gap: 1rem; position: relative; z-index: 1; }
  .friend-avatar {
    width: 52px; height: 52px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--fc), color-mix(in srgb, var(--fc) 60%, white));
    box-shadow: 0 0 0 2px var(--bg-card), 0 4px 12px color-mix(in srgb, var(--fc) 35%, transparent);
    transition: transform .3s cubic-bezier(.34,1.56,.64,1);
  }
  .friend-card:hover .friend-avatar { transform: scale(1.08) rotate(-3deg); }

  .friend-id { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .1rem; }
  .friend-name {
    font-size: 1.05rem; font-weight: 700;
    color: var(--ink); letter-spacing: -.015em;
    transition: color .2s;
  }
  .friend-card:hover .friend-name { color: var(--fc); }
  .friend-bio { font-size: .8125rem; color: var(--ink-3); line-height: 1.5; }
  .friend-url {
    font-size: .7rem; color: var(--ink-4);
    font-family: var(--font-mono); letter-spacing: -.02em;
    margin-top: .15rem;
  }

  .friend-arrow {
    color: var(--ink-4); flex-shrink: 0;
    transition: transform .25s cubic-bezier(.34,1.56,.64,1), color .25s;
  }
  .friend-card:hover .friend-arrow {
    color: var(--fc);
    transform: translate(2px,-2px) scale(1.15);
  }

  /* Tags row */
  .friend-tags {
    display: flex; flex-wrap: wrap; gap: .35rem;
    position: relative; z-index: 1;
  }
  .friend-tag {
    font-size: .65rem; font-weight: 600;
    padding: .2rem .55rem;
    border-radius: 999px;
    color: var(--fc);
    background: color-mix(in srgb, var(--fc) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--fc) 25%, transparent);
    letter-spacing: .02em;
  }

  /* Quote note */
  .friend-note {
    position: relative; z-index: 1;
    margin: 0;
    padding: .75rem .9rem .75rem 2rem;
    background: color-mix(in srgb, var(--fc) 4%, transparent);
    border-left: 2px solid color-mix(in srgb, var(--fc) 40%, transparent);
    border-radius: 0 8px 8px 0;
  }
  .friend-quote-mark {
    position: absolute;
    top: -.15rem; left: .45rem;
    font-family: Georgia, serif;
    font-size: 2.4rem;
    line-height: 1;
    color: color-mix(in srgb, var(--fc) 50%, transparent);
    font-weight: 700;
    pointer-events: none;
  }
  .friend-note-text {
    display: block;
    font-size: .8125rem; line-height: 1.65;
    color: var(--ink-2);
    font-style: italic;
  }

  /* ── Inspirations (smaller, denser, no card) ── */
  .inspire-list {
    display: flex; flex-direction: column;
    gap: .25rem;
    margin-bottom: 1rem;
  }
  .inspire-row {
    display: flex; align-items: center; gap: .85rem;
    padding: .7rem 1rem;
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: background .15s, transform .15s;
  }
  .inspire-row:hover {
    background: var(--bg-card);
    transform: translateX(2px);
  }
  .inspire-favicon {
    width: 22px; height: 22px;
    border-radius: 5px;
    flex-shrink: 0;
    object-fit: contain;
    background: var(--bg);
  }
  .inspire-text {
    flex: 1; min-width: 0;
    display: flex; flex-direction: column;
    gap: .1rem;
  }
  .inspire-name {
    font-size: .9rem; font-weight: 600;
    color: var(--ink); letter-spacing: -.01em;
  }
  .inspire-desc {
    font-size: .75rem; color: var(--ink-3);
    line-height: 1.5;
    overflow: hidden; text-overflow: ellipsis;
    white-space: nowrap;
  }
  .inspire-host {
    font-size: .7rem;
    color: var(--ink-4);
    font-family: var(--font-mono);
    flex-shrink: 0;
  }
  .inspire-arrow {
    color: var(--ink-4); flex-shrink: 0;
    transition: transform .2s, color .2s;
  }
  .inspire-row:hover .inspire-arrow {
    color: var(--accent);
    transform: translate(2px,-2px);
  }

  /* ── Exchange CTA ── */
  .exchange-card {
    margin-top: 4rem;
    display: flex; align-items: center; gap: 2rem;
    flex-wrap: wrap;
    padding: 2rem;
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--accent) 6%, transparent),
      color-mix(in srgb, var(--accent-4) 6%, transparent));
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    position: relative; overflow: hidden;
  }
  .exchange-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-4), #ec4899);
  }
  .exchange-text { flex: 1; min-width: 200px; }
  .exchange-title {
    font-size: 1.25rem; font-weight: 700;
    color: var(--ink); letter-spacing: -.02em;
    margin-bottom: .35rem;
  }
  .exchange-sub {
    font-size: .875rem; color: var(--ink-3); line-height: 1.55;
  }
  .exchange-actions { display: flex; gap: .65rem; flex-shrink: 0; flex-wrap: wrap; }
  .exchange-btn {
    display: inline-flex; align-items: center; gap: .5rem;
    font-size: .8125rem; font-weight: 600;
    padding: .6rem 1.1rem;
    border-radius: 999px;
    text-decoration: none;
    background: var(--bg-card);
    color: var(--ink);
    border: 1px solid var(--border);
    transition: transform .15s, border-color .15s, background .15s;
  }
  .exchange-btn:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .exchange-btn.primary {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }
  .exchange-btn.primary:hover {
    filter: brightness(1.1);
  }

  @media (max-width: 640px) {
    .friends-grid { grid-template-columns: 1fr; }
    .friend-card { padding: 1.25rem; }
    .exchange-card { padding: 1.5rem; }
    .exchange-actions { width: 100%; }
    .exchange-btn { flex: 1; justify-content: center; }
  }
</style>

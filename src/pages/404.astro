---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — FelixTheForge">
  <div class="wrap fade-up">
    <p class="num grad-text">404</p>
    <h1 class="title">Page not found</h1>
    <p class="sub">This page doesn't exist or was moved.</p>
    <a href="/" class="home-btn">Go home</a>
  </div>
</BaseLayout>
<style>
  .wrap { max-width:28rem; margin:8rem auto; text-align:center; padding:0 1.5rem; }
  .num { font-size:7rem; font-weight:800; letter-spacing:-.05em; line-height:1; margin-bottom:.5rem; }
  .title { font-size:1.5rem; font-weight:700; color:var(--ink); margin-bottom:.75rem; }
  .sub { color:var(--ink-3); margin-bottom:2rem; }
  .home-btn {
    display:inline-flex; font-size:.9375rem; font-weight:600; text-decoration:none;
    background:var(--accent); color:#fff; padding:.75rem 2rem; border-radius:var(--radius-md);
    transition:filter .2s;
  }
  .home-btn:hover { filter:brightness(1.1); }
</style>

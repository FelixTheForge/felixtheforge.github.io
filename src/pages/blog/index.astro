---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

const years = [...new Set(posts.map(p => new Date(p.data.date).getFullYear()))];
---

<BaseLayout title="Writing — FelixTheForge">
  <div class="max-w-2xl mx-auto py-16 fade-in">
    <header class="mb-16">
      <h1 class="font-serif text-4xl font-medium mb-3">Writing</h1>
      <p class="text-muted font-serif italic">
        {posts.length} {posts.length === 1 ? 'piece' : 'pieces'} so far.
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="text-muted font-serif italic text-center py-16">The forge is heating up.</p>
    ) : (
      years.map(year => (
        <section class="mb-14">
          <div class="flex items-center gap-4 mb-8">
            <span class="font-sans text-xs text-muted tracking-widest">{year}</span>
            <div class="flex-1 h-px bg-border"></div>
          </div>
          <ul class="space-y-8">
            {posts
              .filter(p => new Date(p.data.date).getFullYear() === year)
              .map(post => (
                <li>
                  <a href={`/blog/${post.id}`} class="group flex items-baseline justify-between gap-6">
                    <div>
                      <h2 class="font-serif text-lg font-medium group-hover:text-accent transition-colors mb-1">
                        {post.data.title}
                      </h2>
                      {post.data.description && (
                        <p class="text-muted font-serif text-sm leading-relaxed">{post.data.description}</p>
                      )}
                    </div>
                    <time class="font-sans text-xs text-muted tracking-wide shrink-0">
                      {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                    </time>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      ))
    )}
  </div>
</BaseLayout>

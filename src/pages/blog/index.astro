---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

const years = [...new Set(posts.map(p => new Date(p.data.date).getFullYear()))];
---

<BaseLayout title="Writing — FelixTheForge">
  <div class="fade-in" style="max-width:42rem; margin:0 auto; padding:4rem 0;">
    <header style="margin-bottom:4rem;">
      <h1 style="font-family:var(--font-serif); font-size:2.5rem; font-weight:500; margin-bottom:0.75rem; color:var(--color-ink);">Writing</h1>
      <p style="color:var(--color-muted); font-family:var(--font-serif); font-style:italic;">
        {posts.length} {posts.length === 1 ? 'piece' : 'pieces'} so far.
      </p>
    </header>

    {posts.length === 0 ? (
      <p style="color:var(--color-muted); font-family:var(--font-serif); font-style:italic; text-align:center; padding:4rem 0;">The forge is heating up.</p>
    ) : (
      years.map(year => (
        <section style="margin-bottom:3.5rem;">
          <div style="display:flex; align-items:center; gap:1rem; margin-bottom:2rem;">
            <span style="font-family:var(--font-sans); font-size:0.75rem; color:var(--color-muted); letter-spacing:0.1em;">{year}</span>
            <div style="flex:1; height:1px; background:var(--color-border);"></div>
          </div>
          <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:2rem;">
            {posts
              .filter(p => new Date(p.data.date).getFullYear() === year)
              .map(post => (
                <li>
                  <a href={`/blog/${post.id}`} class="post-link">
                    <div style="display:flex; align-items:baseline; justify-content:space-between; gap:1.5rem;">
                      <div>
                        <h2 class="post-title">{post.data.title}</h2>
                        {post.data.description && (
                          <p style="color:var(--color-muted); font-family:var(--font-serif); font-size:0.9375rem; line-height:1.6; margin-top:0.25rem;">{post.data.description}</p>
                        )}
                      </div>
                      <time style="font-family:var(--font-sans); font-size:0.75rem; color:var(--color-muted); white-space:nowrap; letter-spacing:0.05em;">
                        {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                      </time>
                    </div>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      ))
    )}
  </div>
</BaseLayout>

<style>
  .post-link { text-decoration: none; display: block; }
  .post-title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-ink);
    transition: color 0.2s;
  }
  .post-link:hover .post-title { color: var(--color-accent); }
</style>

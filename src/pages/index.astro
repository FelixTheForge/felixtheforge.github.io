---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../utils/readingTime';
import { SITE } from '../config/site';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 4);
---

<BaseLayout title={SITE.title} heroHeader={true}>

  <!-- ── Hero ── -->
  <section class="hero">
    <div class="hero-bg" style={`background-image:url('${SITE.heroBg}')`}></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-tag" data-i18n="hero.tag">Personal Blog</div>
      <h1 class="hero-title">{SITE.title.replace('TheForge','')}<span class="accent">TheForge</span></h1>
      <p class="hero-sub" id="hero-sub-text">{SITE.heroSubEn}</p>
      <div class="hero-actions">
        <a href="/blog" class="btn-primary" data-i18n="hero.readBtn">Read Writing</a>
        <a href="/about" class="btn-ghost" data-i18n="hero.aboutBtn">About Me</a>
      </div>
      <div class="hero-socials">
        {SITE.social.github && (
          <a href={SITE.social.github} target="_blank" rel="noopener" class="social-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            GitHub
          </a>
        )}
      </div>
    </div>
    <div class="hero-scroll">
      <span data-i18n="hero.scroll">Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- ── Featured ── -->
  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-hd"><div class="ln"></div><span class="lb" data-i18n="home.featured">Featured</span><div class="ln"></div></div>
        <a href={`/blog/${posts[0].id}`} class="featured-card">
          {posts[0].data.cover && (
            <div class="feat-img-wrap">
              <img src={posts[0].data.cover} alt={posts[0].data.title} class="feat-img" loading="lazy"/>
              <div class="feat-img-ov"></div>
            </div>
          )}
          <div class="feat-body">
            <div class="feat-meta">
              <time>{new Date(posts[0].data.date).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</time>
              <span>·</span><span>{readingTime(posts[0].body ?? '')}</span>
              {posts[0].data.tags?.[0] && <span class="feat-tag">{posts[0].data.tags[0]}</span>}
            </div>
            <h2 class="feat-title">{posts[0].data.title}</h2>
            {posts[0].data.description && <p class="feat-desc">{posts[0].data.description}</p>}
            <span class="read-more" data-i18n="post.readMore">Read more →</span>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- ── Post grid ── -->
  {posts.length > 1 && (
    <section class="section">
      <div class="container">
        <div class="section-hd"><div class="ln"></div><span class="lb" data-i18n="home.recent">Recent Writings</span><div class="ln"></div></div>
        <div class="post-grid">
          {posts.slice(1).map((post, i) => (
            <a href={`/blog/${post.id}`} class="post-card" style={`animation-delay:${i*80}ms`}>
              {post.data.cover && (
                <div class="card-img-wrap">
                  <img src={post.data.cover} alt="" class="card-img" loading="lazy"/>
                  <div class="card-img-ov"></div>
                </div>
              )}
              <div class="card-body">
                <div class="card-meta">
                  <time>{new Date(post.data.date).toLocaleDateString('en-US',{month:'short',year:'numeric'})}</time>
                  <span>·</span><span>{readingTime(post.body ?? '')}</span>
                </div>
                <h3 class="card-title">{post.data.title}</h3>
                {post.data.description && <p class="card-desc">{post.data.description}</p>}
                <div class="card-ft">
                  {post.data.tags?.slice(0,2).map(t => <span class="tag">{t}</span>)}
                </div>
              </div>
            </a>
          ))}
        </div>
        <div class="more-wrap">
          <a href="/blog" class="more-link">
            <span data-i18n="home.allWritings">All writings</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ── About strip ── -->
  <section class="about-strip">
    <div class="container">
      <div class="strip-inner">
        <img src={SITE.avatar} alt="Felix" class="strip-avatar"/>
        <div class="strip-text">
          <p class="strip-name">{SITE.title}</p>
          <p class="strip-bio" id="strip-bio">{SITE.bioEn}</p>
        </div>
        <a href="/about" class="strip-btn" data-i18n="hero.aboutBtn">About Me →</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  import { SITE } from '../config/site';

  // Update hero subtitle and bio on lang change
  function syncText() {
    const lang = localStorage.getItem('lang') || 'en';
    const heroSub = document.getElementById('hero-sub-text');
    const stripBio = document.getElementById('strip-bio');
    if (heroSub) heroSub.textContent = lang === 'zh' ? SITE.heroSubZh : SITE.heroSubEn;
    if (stripBio) stripBio.textContent = lang === 'zh' ? SITE.bioZh : SITE.bioEn;
  }

  syncText();
  document.getElementById('lang-toggle')?.addEventListener('click', () => {
    setTimeout(syncText, 0);
  });
</script>

<style>
/* ─── Hero ─── */
.hero {
  position: relative; height: 100vh; min-height: 600px;
  display: flex; align-items: center; justify-content: center;
  margin: 0 -1.5rem; overflow: hidden;
}
.hero-bg {
  position: absolute; inset: 0;
  background-size: cover; background-position: center 40%;
  transform: scale(1.05);
  animation: zoom 22s ease-in-out infinite alternate;
  transition: filter .3s;
}
[data-theme="dark"] .hero-bg { filter: brightness(.75); }
@keyframes zoom { from{transform:scale(1.05)} to{transform:scale(1.13)} }

.hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to bottom,rgba(10,14,10,.35) 0%,rgba(10,14,10,.5) 50%,rgba(10,14,10,.82) 100%);
}
.hero-content {
  position: relative; z-index: 1; text-align: center; padding: 0 1.5rem;
  animation: fadeUp .9s ease both;
}
@keyframes fadeUp { from{opacity:0;transform:translateY(24px)} to{opacity:1;transform:translateY(0)} }

.hero-tag {
  display: inline-block; font-family: var(--font-sans); font-size: .65rem;
  letter-spacing: .3em; text-transform: uppercase; color: rgba(255,255,255,.65);
  border: 1px solid rgba(255,255,255,.28); padding: .3rem .9rem; border-radius: 999px; margin-bottom: 1.75rem;
}
.hero-title {
  font-family: var(--font-serif); font-size: clamp(3.5rem,9vw,6.5rem); font-weight: 500;
  line-height: 1.05; color: #fff; margin-bottom: 1.25rem; letter-spacing: -.02em;
  text-shadow: 0 2px 40px rgba(0,0,0,.35);
}
.accent { color: #a8c5a0; }
.hero-sub {
  font-family: var(--font-serif); font-size: 1.15rem; font-style: italic;
  color: rgba(255,255,255,.72); line-height: 1.8; margin-bottom: 2.5rem;
  white-space: pre-line;
}
.hero-actions { display:flex; gap:1rem; justify-content:center; margin-bottom:2rem; }
.btn-primary {
  font-family: var(--font-sans); font-size:.75rem; letter-spacing:.1em; text-transform:uppercase;
  text-decoration:none; color:#fff; background:rgba(255,255,255,.15); border:1px solid rgba(255,255,255,.4);
  backdrop-filter:blur(8px); padding:.7rem 1.75rem; border-radius:2px; transition:background .2s,transform .2s;
}
.btn-primary:hover { background:rgba(255,255,255,.28); transform:translateY(-2px); }
.btn-ghost {
  font-family:var(--font-sans); font-size:.75rem; letter-spacing:.1em; text-transform:uppercase;
  text-decoration:none; color:rgba(255,255,255,.65); border:1px solid rgba(255,255,255,.22);
  padding:.7rem 1.75rem; border-radius:2px; transition:color .2s,border-color .2s,transform .2s;
}
.btn-ghost:hover { color:#fff; border-color:rgba(255,255,255,.55); transform:translateY(-2px); }
.hero-socials { display:flex; gap:1.25rem; justify-content:center; }
.social-link {
  display:flex; align-items:center; gap:.4rem; font-family:var(--font-sans); font-size:.75rem;
  color:rgba(255,255,255,.5); text-decoration:none; transition:color .2s;
}
.social-link:hover { color:rgba(255,255,255,.9); }
.hero-scroll {
  position:absolute; bottom:2rem; left:50%; transform:translateX(-50%);
  display:flex; flex-direction:column; align-items:center; gap:.5rem;
  font-family:var(--font-sans); font-size:.6rem; letter-spacing:.2em;
  text-transform:uppercase; color:rgba(255,255,255,.4);
}
.scroll-line {
  width:1px; height:2.5rem;
  background:linear-gradient(to bottom,rgba(255,255,255,.4),transparent);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse { 0%,100%{opacity:.4} 50%{opacity:1} }

/* ─── Sections ─── */
.section { padding: 5rem 0 2rem; }
.container { max-width: 56rem; margin: 0 auto; padding: 0 1.5rem; }
.section-hd { display:flex; align-items:center; gap:1rem; margin-bottom:2.5rem; }
.ln { flex:1; height:1px; background:var(--color-border); }
.lb { font-family:var(--font-sans); font-size:.65rem; color:var(--color-muted); letter-spacing:.22em; text-transform:uppercase; white-space:nowrap; }

/* ─── Featured ─── */
.featured-card {
  display:grid; grid-template-columns:1.1fr 1fr; text-decoration:none;
  border-radius:8px; overflow:hidden; border:1px solid var(--color-border);
  background:var(--color-surface); box-shadow:var(--shadow-sm);
  transition:box-shadow .3s,transform .3s;
}
.featured-card:hover { box-shadow:var(--shadow-lg); transform:translateY(-4px); }
.feat-img-wrap { position:relative; overflow:hidden; aspect-ratio:4/3; }
.feat-img { width:100%; height:100%; object-fit:cover; transition:transform .5s; }
.featured-card:hover .feat-img { transform:scale(1.06); }
.feat-img-ov { position:absolute; inset:0; background:linear-gradient(135deg,rgba(0,0,0,.08),transparent); }
.feat-body {
  padding:2.5rem; display:flex; flex-direction:column; justify-content:center;
  background:var(--color-surface);
}
.feat-meta {
  display:flex; align-items:center; gap:.5rem; flex-wrap:wrap;
  font-family:var(--font-sans); font-size:.7rem; color:var(--color-muted); margin-bottom:1rem;
}
.feat-tag {
  background:color-mix(in srgb,var(--color-accent) 12%,transparent);
  color:var(--color-accent); font-size:.62rem; letter-spacing:.1em; text-transform:uppercase;
  padding:.2rem .55rem; border-radius:2px;
}
.feat-title {
  font-family:var(--font-serif); font-size:1.75rem; font-weight:500; color:var(--color-ink);
  line-height:1.3; margin-bottom:.75rem; transition:color .2s;
}
.featured-card:hover .feat-title { color:var(--color-accent); }
.feat-desc { font-family:var(--font-serif); font-size:1rem; color:var(--color-muted); line-height:1.7; margin-bottom:1.5rem; flex:1; }
.read-more { font-family:var(--font-sans); font-size:.75rem; letter-spacing:.1em; text-transform:uppercase; color:var(--color-accent); }

/* ─── Post grid ─── */
.post-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2.5rem; }
.post-card {
  text-decoration:none; border-radius:8px; overflow:hidden;
  border:1px solid var(--color-border); background:var(--color-surface);
  box-shadow:var(--shadow-sm); transition:box-shadow .3s,transform .3s;
  opacity:0; animation:slideUp .5s ease forwards;
}
.post-card:hover { box-shadow:var(--shadow-md); transform:translateY(-4px); }
@keyframes slideUp { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }
.card-img-wrap { overflow:hidden; aspect-ratio:16/10; position:relative; }
.card-img { width:100%; height:100%; object-fit:cover; transition:transform .5s; }
.post-card:hover .card-img { transform:scale(1.06); }
.card-img-ov { position:absolute; inset:0; background:linear-gradient(to bottom,transparent 50%,rgba(0,0,0,.08)); }
.card-body { padding:1.25rem; }
.card-meta { display:flex; align-items:center; gap:.4rem; font-family:var(--font-sans); font-size:.65rem; color:var(--color-muted); margin-bottom:.6rem; }
.card-title { font-family:var(--font-serif); font-size:1.1rem; font-weight:500; color:var(--color-ink); line-height:1.35; margin-bottom:.5rem; transition:color .2s; }
.post-card:hover .card-title { color:var(--color-accent); }
.card-desc {
  font-family:var(--font-serif); font-size:.875rem; color:var(--color-muted);
  line-height:1.6; margin-bottom:.75rem;
  display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;
}
.card-ft { display:flex; gap:.35rem; flex-wrap:wrap; }
.tag {
  font-family:var(--font-sans); font-size:.6rem; letter-spacing:.1em; text-transform:uppercase;
  color:var(--color-accent); background:color-mix(in srgb,var(--color-accent) 10%,transparent);
  padding:.15rem .45rem; border-radius:2px;
}
.more-wrap { display:flex; justify-content:center; padding:1.5rem 0 2rem; }
.more-link {
  display:flex; align-items:center; gap:.5rem; font-family:var(--font-sans); font-size:.75rem;
  letter-spacing:.12em; text-transform:uppercase; color:var(--color-muted); text-decoration:none;
  border:1px solid var(--color-border); padding:.7rem 1.75rem; border-radius:2px;
  transition:color .2s,border-color .2s,gap .2s,background .2s;
}
.more-link:hover { color:var(--color-accent); border-color:var(--color-accent); gap:.75rem; background:color-mix(in srgb,var(--color-accent) 5%,transparent); }

/* ─── About strip ─── */
.about-strip {
  padding: 4rem 0 5rem;
  background: linear-gradient(135deg,
    color-mix(in srgb, var(--color-accent) 8%, var(--color-bg)),
    color-mix(in srgb, var(--color-accent2) 6%, var(--color-bg))
  );
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}
.strip-inner { display:flex; align-items:center; gap:2rem; }
.strip-avatar { width:5rem; height:5rem; border-radius:50%; object-fit:cover; border:3px solid var(--color-border); flex-shrink:0; }
.strip-text { flex:1; }
.strip-name { font-family:var(--font-serif); font-size:1.1rem; font-weight:500; color:var(--color-ink); margin-bottom:.35rem; }
.strip-bio { font-family:var(--font-serif); font-style:italic; color:var(--color-muted); line-height:1.65; }
.strip-btn {
  font-family:var(--font-sans); font-size:.75rem; letter-spacing:.1em; text-transform:uppercase;
  color:var(--color-accent); text-decoration:none; border:1px solid color-mix(in srgb,var(--color-accent) 40%,transparent);
  padding:.65rem 1.25rem; border-radius:2px; white-space:nowrap; flex-shrink:0;
  transition:background .2s;
}
.strip-btn:hover { background:color-mix(in srgb,var(--color-accent) 10%,transparent); }

@media (max-width:700px) {
  .featured-card { grid-template-columns:1fr; }
  .post-grid { grid-template-columns:1fr; }
  .strip-inner { flex-direction:column; text-align:center; }
}
</style>

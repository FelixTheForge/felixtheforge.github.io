---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 5);
---

<BaseLayout title="FelixTheForge" heroHeader={true}>

  <!-- Full-screen Hero with landscape background -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <div class="hero-tag">Personal Blog</div>

      <h1 class="hero-title">
        Felix<span class="accent">TheForge</span>
      </h1>

      <p class="hero-sub">
        Writing about technology, craft,<br />and the slow accumulation of ideas.
      </p>

      <div class="hero-actions">
        <a href="/blog" class="btn-primary">Read Writing</a>
        <a href="/about" class="btn-ghost">About Me</a>
      </div>

      <div class="hero-socials">
        <a href="https://github.com/FelixTheForge" target="_blank" rel="noopener" class="social-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          GitHub
        </a>
      </div>
    </div>

    <div class="hero-scroll">
      <span>Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- Posts Section -->
  <section class="posts-section">
    <div class="posts-inner">

      <div class="section-header">
        <div class="section-line"></div>
        <span class="section-label">Recent Writings</span>
        <div class="section-line"></div>
      </div>

      {posts.length === 0 ? (
        <p class="empty-state">No writings yet. The forge is heating up.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post, i) => (
            <li class="post-item" style={`animation-delay:${i * 100}ms`}>
              <a href={`/blog/${post.id}`} class="post-card">
                <span class="post-num">0{i + 1}</span>
                <div class="post-body">
                  <h2 class="post-title">{post.data.title}</h2>
                  {post.data.description && (
                    <p class="post-desc">{post.data.description}</p>
                  )}
                  {post.data.tags?.length > 0 && (
                    <div class="post-tags">
                      {post.data.tags.map(t => <span class="tag">{t}</span>)}
                    </div>
                  )}
                </div>
                <div class="post-meta">
                  <time class="post-date">
                    {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                  </time>
                  <span class="post-arrow">→</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}

      <div class="more-wrap">
        <a href="/blog" class="more-link">
          All writings
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ─── Hero ─── */
  .hero {
    position: relative;
    height: 100vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 -1.5rem;   /* bleed past BaseLayout padding */
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1800&q=80');
    background-size: cover;
    background-position: center 40%;
    transform: scale(1.05);
    animation: slowZoom 20s ease-in-out infinite alternate;
  }

  @keyframes slowZoom {
    from { transform: scale(1.05); }
    to   { transform: scale(1.12); }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(20, 24, 20, 0.45) 0%,
      rgba(20, 24, 20, 0.55) 50%,
      rgba(20, 24, 20, 0.75) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 0 1.5rem;
    animation: fadeUp 1s ease both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-tag {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    border: 1px solid rgba(255,255,255,0.25);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1.75rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 9vw, 6.5rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 40px rgba(0,0,0,0.3);
  }

  .hero-title .accent {
    color: #a8c5a0;
  }

  .hero-sub {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-style: italic;
    color: rgba(255,255,255,0.72);
    line-height: 1.8;
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .btn-primary {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: #fff;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.4);
    backdrop-filter: blur(8px);
    padding: 0.7rem 1.75rem;
    border-radius: 2px;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }
  .btn-primary:hover {
    background: rgba(255,255,255,0.25);
    border-color: rgba(255,255,255,0.7);
    transform: translateY(-2px);
  }

  .btn-ghost {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(255,255,255,0.65);
    border: 1px solid rgba(255,255,255,0.2);
    padding: 0.7rem 1.75rem;
    border-radius: 2px;
    transition: color 0.2s, border-color 0.2s, transform 0.2s;
  }
  .btn-ghost:hover {
    color: #fff;
    border-color: rgba(255,255,255,0.5);
    transform: translateY(-2px);
  }

  .hero-socials {
    display: flex;
    gap: 1.25rem;
    justify-content: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: color 0.2s;
  }
  .social-link:hover { color: rgba(255,255,255,0.9); }

  /* scroll indicator */
  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    animation: fadeUp 1s 0.5s ease both;
  }
  .scroll-line {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(to bottom, rgba(255,255,255,0.4), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.4; transform: scaleY(1); }
    50%       { opacity: 1;   transform: scaleY(1.1); }
  }

  /* ─── Posts Section ─── */
  .posts-section { padding: 5rem 0; }
  .posts-inner { max-width: 42rem; margin: 0 auto; }

  .section-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .section-line { flex: 1; height: 1px; background: var(--color-border); }
  .section-label {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    color: var(--color-muted);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .post-list { list-style: none; margin: 0; padding: 0; }

  .post-item {
    opacity: 0;
    animation: slideUp 0.5s ease forwards;
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .post-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.2s;
  }
  .post-card:hover {
    background: color-mix(in srgb, var(--color-accent) 5%, transparent);
  }

  .post-num {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    margin-top: 0.3rem;
    min-width: 1.5rem;
  }

  .post-body { flex: 1; }

  .post-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--color-ink);
    margin-bottom: 0.35rem;
    transition: color 0.2s;
  }
  .post-card:hover .post-title { color: var(--color-accent); }

  .post-desc {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.65;
    margin-bottom: 0.6rem;
  }

  .post-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .tag {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    min-width: 5rem;
  }

  .post-date {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .post-arrow {
    color: var(--color-border);
    font-size: 1rem;
    transition: color 0.2s, transform 0.2s;
  }
  .post-card:hover .post-arrow {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  .more-wrap {
    display: flex;
    justify-content: flex-end;
    margin-top: 2rem;
  }

  .more-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s, gap 0.2s;
  }
  .more-link:hover { color: var(--color-accent); gap: 0.75rem; }

  .empty-state {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-muted);
    text-align: center;
    padding: 4rem 0;
  }
</style>

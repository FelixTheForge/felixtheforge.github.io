---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../utils/readingTime';
import { SITE } from '../config/site';

const posts = (await getCollection('blog'))
  .sort((a,b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
const featured = posts[0];
const recent = posts.slice(1,4);

// Tag color map
const tagColors = ['#0071e3','#bf5af2','#30d158','#ff9f0a','#ff375f','#5e5ce6','#00c7be'];
const tagColorMap: Record<string,string> = {};
let tci = 0;
posts.forEach(p => p.data.tags?.forEach(t => { if(!tagColorMap[t]) tagColorMap[t]=tagColors[tci++ % tagColors.length]; }));
---

<BaseLayout title={SITE.title} transparentNav={true}>

  <!-- ── Hero ── -->
  <section class="hero">
    <div class="hero-bg-wrap">
      <div class="hero-bg" style={`background-image:url('${SITE.heroBg}')`}></div>
      <div class="hero-bg-fade"></div>
    </div>

    <div class="hero-inner">
      <div class="hero-badge fade-up">
        <span class="badge-dot"></span>
        <span data-i18n-custom="hero-badge">Personal Blog</span>
      </div>

      <h1 class="hero-title fade-up" style="animation-delay:.1s">
        <span id="hero-name">{SITE.title}</span>
      </h1>

      <p class="hero-sub fade-up" id="hero-sub" style="animation-delay:.2s">{SITE.heroSubEn}</p>

      <div class="hero-cta fade-up" style="animation-delay:.3s">
        <a href="/blog" class="btn-primary" data-i18n-custom="cta-blog">Read Writing</a>
        <a href="/minecraft" class="btn-mc">
          <span class="btn-mc-dot"></span>
          <span data-i18n-custom="cta-mc">Minecraft Server</span>
        </a>
        <a href="/about" class="btn-outline" data-i18n-custom="cta-about">About Me</a>
      </div>
    </div>

    <div class="hero-scroll-hint">
      <div class="scroll-dot"></div>
    </div>
  </section>

  <!-- ── Minecraft community teaser (right after hero, high-impact) ── -->
  <section class="mc-teaser-section">
    <div class="container">
      <a href="/minecraft" class="mc-teaser">
        <div class="mc-teaser-bg" style="background-image:url('/minecraft/banner-md.jpg')"></div>
        <div class="mc-teaser-overlay"></div>
        <div class="mc-teaser-deco" aria-hidden="true">
          <span class="mc-deco mc-deco-1">⛏</span>
          <span class="mc-deco mc-deco-2">💎</span>
          <span class="mc-deco mc-deco-3">🟩</span>
        </div>
        <div class="mc-teaser-content">
          <span class="mc-teaser-badge">
            <span class="mc-teaser-dot"></span>
            <span data-i18n-custom="mc-teaser-live">LIVE · MC 1.21.x</span>
          </span>
          <h2 class="mc-teaser-title">
            <span class="mc-teaser-title-main">ForgeCraft</span>
            <span class="mc-teaser-title-sub" data-i18n-custom="mc-teaser-tag">A Minecraft community for builders.</span>
          </h2>
          <div class="mc-teaser-meta">
            <span class="mc-teaser-stat"><strong>300+</strong> <em data-i18n-custom="mc-teaser-members">members</em></span>
            <span class="mc-teaser-stat"><strong>2yr+</strong> <em data-i18n-custom="mc-teaser-active">active</em></span>
            <span class="mc-teaser-stat"><strong>24/7</strong> <em data-i18n-custom="mc-teaser-online">online</em></span>
          </div>
          <span class="mc-teaser-cta" data-i18n-custom="mc-teaser-cta">Enter the server →</span>
        </div>
      </a>
    </div>
  </section>

  <!-- ── Featured post ── -->
  {featured && (
    <section class="section">
      <div class="container">
        <div class="section-label">
          <span class="label-line"></span>
          <span class="label-text" data-i18n-custom="featured">Featured</span>
        </div>

        <a href={`/blog/${featured.id}`} class="featured-card card">
          <div class="feat-img-wrap">
            {featured.data.cover
              ? <img src={featured.data.cover} alt={featured.data.title} class="feat-img" loading="lazy"/>
              : <div class="feat-img-fallback"></div>
            }
            <div class="feat-img-shine"></div>
          </div>
          <div class="feat-body">
            <div class="feat-tags">
              {featured.data.tags?.slice(0,2).map(t => (
                <span class="pill" style={`color:${tagColorMap[t]};background:${tagColorMap[t]}18`}>{t}</span>
              ))}
            </div>
            <h2 class="feat-title">{featured.data.title}</h2>
            {featured.data.description && <p class="feat-desc">{featured.data.description}</p>}
            <div class="feat-meta">
              <time>{new Date(featured.data.date).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</time>
              <span>·</span>
              <span>{readingTime(featured.body??'')}</span>
            </div>
            <span class="feat-cta grad-text" data-i18n-custom="read-more">Read article →</span>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- ── Recent posts ── -->
  {recent.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-label">
          <span class="label-line"></span>
          <span class="label-text" data-i18n-custom="recent">Recent</span>
        </div>
        <div class="post-grid">
          {recent.map((post,i) => (
            <a href={`/blog/${post.id}`} class="post-card card fade-up" style={`animation-delay:${i*.08}s`}>
              {post.data.cover && (
                <div class="card-img-wrap">
                  <img src={post.data.cover} alt="" class="card-img" loading="lazy"/>
                </div>
              )}
              <div class="card-body">
                <div class="card-tags">
                  {post.data.tags?.slice(0,2).map(t => (
                    <span class="pill" style={`color:${tagColorMap[t]};background:${tagColorMap[t]}18`}>{t}</span>
                  ))}
                </div>
                <h3 class="card-title">{post.data.title}</h3>
                {post.data.description && <p class="card-desc">{post.data.description}</p>}
                <div class="card-meta">
                  <time>{new Date(post.data.date).toLocaleDateString('en-US',{month:'short',year:'numeric'})}</time>
                  <span>·</span>
                  <span>{readingTime(post.body??'')}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
        <div class="more-row">
          <a href="/blog" class="more-btn" data-i18n-custom="all-posts">All posts →</a>
        </div>
      </div>
    </section>
  )}

  <!-- ── Profile strip ── -->
  <section class="profile-strip">
    <div class="container">
      <div class="profile-inner glass card">
        <img src={SITE.avatar} alt={SITE.title} class="profile-avatar"/>
        <div class="profile-text">
          <p class="profile-name">{SITE.title}</p>
          <p class="profile-role">{SITE.role}</p>
          <p class="profile-bio" id="profile-bio">{SITE.bioEn}</p>
        </div>
        <div class="profile-actions">
          <a href="/about" class="btn-primary" data-i18n-custom="learn-more">Learn more</a>
          {SITE.social.github && (
            <a href={SITE.social.github} target="_blank" rel="noopener" class="btn-outline">GitHub</a>
          )}
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  import { SITE } from '../config/site';

  const I18N_CUSTOM: Record<string, Record<string,string>> = {
    en: {
      'hero-badge':'Personal Blog','cta-blog':'Read Writing','cta-about':'About Me',
      'featured':'Featured','recent':'Recent','read-more':'Read article →',
      'all-posts':'All posts →','learn-more':'Learn more',
      'cta-mc':'Minecraft Server',
      'mc-teaser-live':'LIVE · MC 1.21.x',
      'mc-teaser-tag':'A Minecraft community for builders.',
      'mc-teaser-members':'members','mc-teaser-active':'active','mc-teaser-online':'online',
      'mc-teaser-cta':'Enter the server →',
    },
    zh: {
      'hero-badge':'个人博客','cta-blog':'阅读文章','cta-about':'关于我',
      'featured':'精选','recent':'最近','read-more':'阅读全文 →',
      'all-posts':'全部文章 →','learn-more':'了解更多',
      'cta-mc':'我的世界服',
      'mc-teaser-live':'在线 · MC 1.21.x',
      'mc-teaser-tag':'一个属于建造者的 Minecraft 社群。',
      'mc-teaser-members':'群友','mc-teaser-active':'运营','mc-teaser-online':'在线',
      'mc-teaser-cta':'进入服务器 →',
    },
  };

  function syncPage() {
    const lang = localStorage.getItem('lang') || 'en';
    const map = I18N_CUSTOM[lang];
    document.querySelectorAll('[data-i18n-custom]').forEach(el => {
      const key = el.getAttribute('data-i18n-custom')!;
      if (map[key]) el.textContent = map[key];
    });
    const bio = document.getElementById('profile-bio');
    if (bio) bio.textContent = lang === 'zh' ? SITE.bioZh : SITE.bioEn;
    const sub = document.getElementById('hero-sub');
    if (sub) sub.textContent = (lang === 'zh' ? SITE.heroSubZh : SITE.heroSubEn).replace('\\n','\n');
  }

  syncPage();
  document.getElementById('lang-btn')?.addEventListener('click', () => setTimeout(syncPage, 0));
</script>

<style>
/* ── Hero ── */
.hero {
  position: relative;
  height: 100svh; min-height: 640px;
  display: flex; align-items: center;
  overflow: hidden;
}
.hero-bg-wrap { position: absolute; inset: 0; }
.hero-bg {
  position: absolute; inset: 0;
  background-size: cover; background-position: center;
  animation: heroZoom 24s ease-in-out infinite alternate;
}
@keyframes heroZoom { from{transform:scale(1.04)} to{transform:scale(1.1)} }
[data-theme="dark"] .hero-bg { filter: brightness(.6) saturate(.9); }

.hero-bg-fade {
  position: absolute; inset: 0;
  background: linear-gradient(
    to right,
    rgba(0,0,0,.62) 0%,
    rgba(0,0,0,.4) 50%,
    rgba(0,0,0,.15) 100%
  );
}
[data-theme="light"] .hero-bg-fade {
  background: linear-gradient(
    to right,
    rgba(0,0,0,.55) 0%,
    rgba(0,0,0,.3) 55%,
    rgba(0,0,0,.05) 100%
  );
}

.hero-inner {
  position: relative; z-index: 1;
  max-width: 68rem; margin: 0 auto; padding: 0 1.5rem;
  width: 100%;
}

.hero-badge {
  display: inline-flex; align-items: center; gap: .5rem;
  font-size: .75rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase;
  color: rgba(255,255,255,.75);
  background: rgba(255,255,255,.12);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.2);
  padding: .375rem .875rem; border-radius: 999px; margin-bottom: 1.75rem;
}
.badge-dot {
  width: .375rem; height: .375rem; border-radius: 50%;
  background: #30d158; box-shadow: 0 0 6px #30d158;
  animation: blink 2s ease-in-out infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.4} }

.hero-title {
  font-size: clamp(3rem,8vw,5.5rem); font-weight: 700;
  color: #fff; letter-spacing: -.03em; line-height: 1.05;
  margin-bottom: 1.25rem;
  text-shadow: 0 2px 32px rgba(0,0,0,.25);
}

.hero-sub {
  font-size: clamp(1rem,2vw,1.25rem); font-weight: 300;
  color: rgba(255,255,255,.75); line-height: 1.7;
  margin-bottom: 2.5rem; max-width: 34rem; white-space: pre-line;
}

.hero-cta { display: flex; gap: .75rem; flex-wrap: wrap; }

.btn-primary {
  display: inline-flex; align-items: center;
  font-size: .9375rem; font-weight: 600; text-decoration: none;
  background: var(--accent); color: #fff;
  padding: .75rem 1.75rem; border-radius: var(--radius-md);
  transition: filter .2s, transform .2s;
  border: none; cursor: pointer;
}
.btn-primary:hover { filter: brightness(1.1); transform: translateY(-1px); }

.btn-outline {
  display: inline-flex; align-items: center;
  font-size: .9375rem; font-weight: 500; text-decoration: none;
  color: rgba(255,255,255,.85);
  background: rgba(255,255,255,.12); backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.28);
  padding: .75rem 1.75rem; border-radius: var(--radius-md);
  transition: background .2s, transform .2s;
  cursor: pointer;
}
.btn-outline:hover { background: rgba(255,255,255,.2); transform: translateY(-1px); }

/* MC server pill button — calls attention to the community page */
.btn-mc {
  display: inline-flex; align-items: center; gap: .5rem;
  font-size: .9375rem; font-weight: 600; text-decoration: none;
  color: #fff;
  background: rgba(48,209,88,.18);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(48,209,88,.55);
  padding: .75rem 1.4rem;
  border-radius: var(--radius-md);
  transition: background .2s, transform .2s, border-color .2s;
  cursor: pointer;
}
.btn-mc:hover {
  background: rgba(48,209,88,.32);
  border-color: rgba(48,209,88,.8);
  transform: translateY(-1px);
}
.btn-mc-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: #30d158;
  box-shadow: 0 0 8px #30d158;
  animation: btnMcPulse 1.6s ease-in-out infinite;
}
@keyframes btnMcPulse {
  0%,100% { opacity: 1; transform: scale(1); }
  50%     { opacity: .55; transform: scale(.85); }
}

/* Non-hero btn-outline */
.profile-actions .btn-outline {
  color: var(--ink-2); background: transparent;
  border-color: var(--border); backdrop-filter: none;
}
.profile-actions .btn-outline:hover { background: var(--border); }

.hero-scroll-hint {
  position: absolute; bottom: 2.5rem; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center;
}
.scroll-dot {
  width: 1.5rem; height: 2.5rem; border: 2px solid rgba(255,255,255,.35); border-radius: 999px;
  position: relative;
}
.scroll-dot::after {
  content: ''; position: absolute; left: 50%; top: .35rem;
  transform: translateX(-50%);
  width: .3rem; height: .6rem; background: rgba(255,255,255,.7); border-radius: 999px;
  animation: scrollPulse 1.8s ease-in-out infinite;
}
@keyframes scrollPulse {
  0%{opacity:1;transform:translateX(-50%) translateY(0)}
  100%{opacity:0;transform:translateX(-50%) translateY(.8rem)}
}

/* ── Sections ── */
.section { padding: 5rem 0 0; }
.container { max-width: 68rem; margin: 0 auto; padding: 0 1.5rem; }

.section-label { display: flex; align-items: center; gap: .875rem; margin-bottom: 2rem; }
.label-line { flex: 0 0 2.5rem; height: 2px; background: var(--grad-1); border-radius: 99px; }
.label-text { font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }

/* ── Featured ── */
.featured-card {
  display: grid; grid-template-columns: 1.1fr 1fr; text-decoration: none;
}
.feat-img-wrap { position: relative; overflow: hidden; aspect-ratio: 4/3; }
.feat-img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.25,.46,.45,.94); }
.featured-card:hover .feat-img { transform: scale(1.05); }
.feat-img-shine {
  position: absolute; inset: 0;
  background: linear-gradient(135deg,rgba(255,255,255,.06) 0%,transparent 60%);
}
.feat-img-fallback {
  width: 100%; height: 100%;
  background:
    radial-gradient(circle at 30% 20%, rgba(0,113,227,.4), transparent 60%),
    radial-gradient(circle at 70% 80%, rgba(191,90,242,.4), transparent 60%),
    linear-gradient(135deg, #0071e3, #5e5ce6 50%, #bf5af2);
}
.feat-body {
  padding: 2.5rem; display: flex; flex-direction: column; justify-content: center;
  background: var(--bg-card);
}
.feat-tags { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1rem; }
.feat-title {
  font-size: 1.625rem; font-weight: 700; color: var(--ink); letter-spacing: -.025em;
  line-height: 1.3; margin-bottom: .875rem; transition: color .2s;
}
.featured-card:hover .feat-title { color: var(--accent); }
.feat-desc { font-size: .9375rem; color: var(--ink-3); line-height: 1.65; margin-bottom: 1.25rem; flex: 1; }
.feat-meta { display: flex; gap: .5rem; align-items: center; font-size: .8125rem; color: var(--ink-4); margin-bottom: 1.25rem; }
.feat-cta { font-size: .875rem; font-weight: 600; }

/* ── Post grid ── */
.post-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.25rem; }
.post-card { text-decoration: none; }
.card-img-wrap { overflow: hidden; aspect-ratio: 16/9; }
.card-img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s cubic-bezier(.25,.46,.45,.94); }
.post-card:hover .card-img { transform: scale(1.05); }
.card-body { padding: 1.375rem; }
.card-tags { display: flex; gap: .4rem; flex-wrap: wrap; margin-bottom: .75rem; }
.card-title {
  font-size: 1.0625rem; font-weight: 600; color: var(--ink); letter-spacing: -.015em;
  line-height: 1.4; margin-bottom: .5rem; transition: color .2s;
}
.post-card:hover .card-title { color: var(--accent); }
.card-desc {
  font-size: .875rem; color: var(--ink-3); line-height: 1.55; margin-bottom: .875rem;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.card-meta { display: flex; gap: .4rem; align-items: center; font-size: .75rem; color: var(--ink-4); }

.more-row { display: flex; justify-content: center; padding: 2.5rem 0; }
.more-btn {
  font-size: .875rem; font-weight: 600; color: var(--accent);
  text-decoration: none; letter-spacing: .01em;
  transition: opacity .2s;
}
.more-btn:hover { opacity: .7; }

/* ── Minecraft teaser ── */
.mc-teaser-section { padding: 3rem 0 1rem; }
.mc-teaser {
  position: relative;
  display: block;
  overflow: hidden;
  border-radius: var(--radius-xl);
  text-decoration: none;
  min-height: 220px;
  border: 1px solid var(--border);
  box-shadow:
    0 4px 16px rgba(0,0,0,.08),
    0 16px 40px rgba(78,175,82,.08);
  transition: transform .3s cubic-bezier(.25,.46,.45,.94),
              box-shadow .3s;
}
.mc-teaser:hover {
  transform: translateY(-4px);
  box-shadow:
    0 8px 24px rgba(0,0,0,.12),
    0 24px 56px rgba(78,175,82,.18);
}
.mc-teaser-bg {
  position: absolute; inset: 0;
  background-size: cover; background-position: center;
  filter: brightness(.5) saturate(1.15);
  transition: transform .6s;
}
.mc-teaser:hover .mc-teaser-bg { transform: scale(1.04); }
.mc-teaser-overlay {
  position: absolute; inset: 0;
  background:
    linear-gradient(90deg, rgba(0,0,0,.75) 0%, rgba(0,0,0,.4) 60%, rgba(78,175,82,.25) 100%);
}

.mc-teaser-deco { position: absolute; inset: 0; pointer-events: none; }
.mc-deco {
  position: absolute;
  font-size: 2.5rem;
  opacity: .35;
  filter: drop-shadow(0 4px 10px rgba(0,0,0,.5));
  animation: mcDecoFloat 6s ease-in-out infinite;
}
.mc-deco-1 { top: 20%; right: 12%; animation-delay: 0s; }
.mc-deco-2 { top: 55%; right: 6%; animation-delay: 1s; font-size: 2rem; }
.mc-deco-3 { top: 70%; right: 22%; animation-delay: 2s; font-size: 2.25rem; }
@keyframes mcDecoFloat {
  0%,100% { transform: translateY(0) rotate(-3deg); }
  50%     { transform: translateY(-12px) rotate(3deg); }
}

.mc-teaser-content {
  position: relative; z-index: 2;
  padding: 2.5rem 2rem;
  color: #fff;
  max-width: 38rem;
}
.mc-teaser-badge {
  display: inline-flex; align-items: center; gap: .5rem;
  font-size: .68rem; font-weight: 600;
  letter-spacing: .14em;
  padding: .3rem .7rem;
  background: rgba(0,0,0,.4);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 4px;
  color: #d4ffd6;
  margin-bottom: 1rem;
  font-family: ui-monospace, 'SF Mono', 'Cascadia Mono', Menlo, monospace;
}
.mc-teaser-dot {
  width: 6px; height: 6px;
  background: #30d158;
  border-radius: 50%;
  box-shadow: 0 0 8px #30d158;
  animation: mcDotPulse 1.6s ease-in-out infinite;
}
@keyframes mcDotPulse {
  0%,100% { opacity: 1; transform: scale(1); }
  50%     { opacity: .5; transform: scale(.8); }
}

.mc-teaser-title {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 800;
  letter-spacing: -.025em;
  line-height: 1.1;
  margin-bottom: 1rem;
  display: flex; flex-direction: column; gap: .35rem;
}
.mc-teaser-title-main {
  background: linear-gradient(135deg, #fff 0%, #d4ffd6 100%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
}
.mc-teaser-title-sub {
  font-size: clamp(.875rem, 1.5vw, 1rem);
  font-weight: 400;
  letter-spacing: 0;
  color: rgba(255,255,255,.85);
}

.mc-teaser-meta {
  display: flex; gap: 1.5rem; margin-bottom: 1.25rem; flex-wrap: wrap;
}
.mc-teaser-stat {
  display: inline-flex; align-items: baseline; gap: .35rem;
  font-size: .8125rem;
  color: rgba(255,255,255,.7);
}
.mc-teaser-stat strong {
  font-size: 1.125rem;
  font-weight: 700;
  color: #fff;
  font-family: ui-monospace, 'SF Mono', 'Cascadia Mono', Menlo, monospace;
}
.mc-teaser-stat em {
  font-style: normal;
  font-size: .7rem;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.mc-teaser-cta {
  display: inline-flex; align-items: center;
  font-size: .9375rem; font-weight: 600;
  background: #30d158;
  color: #052b09;
  padding: .65rem 1.4rem;
  border-radius: 999px;
  transition: transform .2s, background .2s;
